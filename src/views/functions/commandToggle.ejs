<div class="switchRow" data-cmd-toggle="<%= cmd %>">
  <div>
    <div class="switchLabel"><%= title %></div>
    <div class="switchHint"><%= hint %></div>
  </div>
  <label class="switch">
    <input
      type="checkbox"
      name="<%= cmd %>"
      <%= enabled ? "checked" : "" %>
    />
    <span class="slider"></span>
  </label>
</div>