<%
  const items = Array.isArray(notificationItems) ? notificationItems : [];
  const compactMode = !!compact;
  const emptyText =
    typeof emptyMessage === "string" && emptyMessage.trim()
      ? emptyMessage.trim()
      : "No notifications yet.";
%>

<div
  class="notificationList<%= compactMode ? " notificationList--compact" : "" %>"
  data-notification-list="1"
  data-notification-compact="<%= compactMode ? "1" : "0" %>"
  data-empty-message="<%= emptyText %>"
>
  <% if (items.length) { %>
    <% items.forEach((item) => { %>
      <article
        class="notificationItem<%= item.isUnread ? " notificationItem--unread" : "" %>"
        data-notification-id="<%= item.id %>"
      >
        <div class="notificationItemRow">
          <% if (item.actionUrl) { %>
            <a class="notificationItemMain" href="<%= item.actionUrl %>">
              <div class="notificationItemTitleRow">
                <div class="notificationItemTitle"><%= item.title %></div>
                <% if (item.isUnread) { %>
                  <span class="notificationItemDot" aria-hidden="true"></span>
                <% } %>
              </div>
              <div class="notificationItemMessage"><%= item.message %></div>
              <div class="notificationItemMeta">
                <time class="notificationItemTime" datetime="<%= item.createdIso %>"><%= item.createdLabel %></time>
                <% if (item.actionLabel) { %>
                  <span class="notificationItemAction"><%= item.actionLabel %></span>
                <% } %>
              </div>
            </a>
          <% } else { %>
            <div class="notificationItemMain">
              <div class="notificationItemTitleRow">
                <div class="notificationItemTitle"><%= item.title %></div>
                <% if (item.isUnread) { %>
                  <span class="notificationItemDot" aria-hidden="true"></span>
                <% } %>
              </div>
              <div class="notificationItemMessage"><%= item.message %></div>
              <div class="notificationItemMeta">
                <time class="notificationItemTime" datetime="<%= item.createdIso %>"><%= item.createdLabel %></time>
              </div>
            </div>
          <% } %>

          <button
            class="notificationItemClear"
            type="button"
            data-notification-clear="<%= item.id %>"
            aria-label="Clear notification"
            title="Clear notification"
          >
            x
          </button>
        </div>
      </article>
    <% }) %>
  <% } else { %>
    <div class="notificationEmpty" data-notification-empty="1"><%= emptyText %></div>
  <% } %>
</div>
