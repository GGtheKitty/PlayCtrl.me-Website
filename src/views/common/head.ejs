<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title || "PlayCtrl.me" %></title>
<meta name="robots" content="<%= meta?.robots || "noindex, nofollow, noarchive, nosnippet, noimageindex" %>" />
<meta name="googlebot" content="<%= meta?.robots || "noindex, nofollow, noarchive, nosnippet, noimageindex" %>" />
<link rel="canonical" href="<%= meta?.canonicalUrl || "https://playctrl.me/" %>" />
<% if (typeof csrfToken !== "undefined" && csrfToken) { %>
  <meta name="csrf-token" content="<%= csrfToken %>" />
<% } %>
<%- include("csrf_client") %>

<%- include("favicon_links") %>

<meta property="og:type" content="website" />
<meta property="og:site_name" content="PlayCtrl.me" />
<meta property="og:title" content="<%= meta?.ogTitle || title || "PlayCtrl.me" %>" />
<meta property="og:description" content="<%= meta?.ogDesc || "Remote play & control" %>" />
<meta property="og:url" content="<%= meta?.ogUrl || meta?.canonicalUrl || "https://playctrl.me/" %>" />
<meta property="og:image" content="<%= meta?.ogImage || "https://playctrl.me/favicon-96x96.png" %>" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= meta?.ogTitle || title || "PlayCtrl.me" %>" />
<meta name="twitter:description" content="<%= meta?.ogDesc || "Remote play & control" %>" />
<meta name="twitter:image" content="<%= meta?.ogImage || "https://playctrl.me/favicon-96x96.png" %>" />

<link rel="stylesheet" href="/css/main.css" />
<% (typeof extraStylesheets !== "undefined" && Array.isArray(extraStylesheets) ? extraStylesheets : []).forEach((href) => { %>
  <link rel="stylesheet" href="<%= href %>" />
<% }) %>
<%- include("toast_client") %>
