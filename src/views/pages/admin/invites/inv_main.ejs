<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="/css/admin_invites.css" />
</head>
<body>
  <% const userLabel = (row, prefix) => row[`${prefix}_global_name`] || row[`${prefix}_username`] || row[prefix === "creator" ? "created_by" : "used_by"] || "Unknown"; %>

  <div class="invitePageHead">
    <div><h1>Invite management</h1><p class="muted">Issue invites, track referrals, and remove unclaimed access.</p></div>
    <a class="btn" href="/admin">Back to admin</a>
  </div>

  <% if (generatedCount) { %><div class="inviteNotice inviteNotice--success"><%= generatedCount %> invite<%= generatedCount === 1 ? "" : "s" %> generated. The codes are listed below.</div><% } %>
  <% if (deleted) { %><div class="inviteNotice inviteNotice--success">The unclaimed invite was deleted.</div><% } %>

  <section class="inviteStats" aria-label="Invite totals">
    <div class="inviteStat"><strong><%= inviteStats.open %></strong><span>Unclaimed</span></div>
    <div class="inviteStat"><strong><%= inviteStats.claimed %></strong><span>Claimed</span></div>
    <div class="inviteStat"><strong><%= inviteStats.removed %></strong><span>Removed</span></div>
  </section>

  <div class="inviteControls">
    <section class="card">
      <div class="cardHd">Site access</div>
      <div class="cardBd">
        <div class="switchRow">
          <div><div class="switchLabel">Open enrollment</div><div class="switchHint">Keep this off to require a valid one-time invite.</div></div>
          <label class="switch" title="Toggle enrollment"><input id="enrollToggle" type="checkbox" <%= enrollmentOpen ? "checked" : "" %> /><span class="slider"></span></label>
        </div>
        <div id="enrollStatus" class="muted inviteControlStatus"></div>
      </div>
    </section>

    <section class="card">
      <div class="cardHd">Generate admin invites</div>
      <div class="cardBd">
        <form method="POST" action="/admin/invites/new" class="inviteGenerateForm">
          <label><span>Quantity</span><input name="count" type="number" min="1" max="50" value="1" /></label>
          <button type="submit">Generate</button>
        </form>
        <p class="muted inviteControlHint">Admin invites do not use a weekly member allowance.</p>
      </div>
    </section>
  </div>

  <section class="inviteSection">
    <div class="inviteSectionHead"><div><h2>Unclaimed invites</h2><p class="muted">Valid codes that can still be redeemed.</p></div><span class="inviteCount"><%= openInvites.length %> shown</span></div>
    <div class="inviteTableWrap"><table class="inviteTable">
      <thead><tr><th>Code</th><th>Generated by</th><th>Created</th><th></th></tr></thead>
      <tbody>
        <% for (const row of openInvites) { %><tr>
          <td><% if (row.code_plain) { %><button class="inviteCode" type="button" data-copy="<%= row.code_plain %>" title="Copy invite code"><%= row.code_plain %></button><% } else { %><span class="muted">Legacy code unavailable</span><% } %></td>
          <td><a href="/admin/users?q=<%= encodeURIComponent(row.created_by || "") %>"><%= userLabel(row, "creator") %></a><div class="inviteId"><%= row.created_by || "" %></div></td>
          <td><time datetime="<%= new Date(row.created_at).toISOString() %>"><%= new Date(row.created_at).toLocaleString() %></time></td>
          <td class="inviteActionCell"><form method="POST" action="/admin/invites/delete" onsubmit="return confirm('Delete this unclaimed invite? It will stop working immediately.');"><input type="hidden" name="code_hash" value="<%= row.code_hash %>" /><button class="inviteDangerBtn" type="submit">Delete</button></form></td>
        </tr><% } %>
        <% if (!openInvites.length) { %><tr><td colspan="4" class="inviteEmpty">There are no unclaimed invites.</td></tr><% } %>
      </tbody>
    </table></div>
    <% if (openPages > 1) { %><nav class="invitePager" aria-label="Unclaimed invite pages">
      <% if (openPage > 1) { %><a href="<%= invitePageUrl(openPage - 1, claimedPage) %>">Previous</a><% } %>
      <span>Page <%= openPage %> of <%= openPages %></span>
      <% if (openPage < openPages) { %><a href="<%= invitePageUrl(openPage + 1, claimedPage) %>">Next</a><% } %>
    </nav><% } %>
  </section>

  <section class="inviteSection">
    <div class="inviteSectionHead"><div><h2>Claimed invites</h2><p class="muted">Every member who claimed an invite and the member responsible for it.</p></div><span class="inviteCount"><%= claimedInvites.length %> shown</span></div>
    <div class="inviteTableWrap"><table class="inviteTable">
      <thead><tr><th>Claimed by</th><th>Invited by</th><th>Code</th><th>Claimed</th></tr></thead>
      <tbody>
        <% for (const row of claimedInvites) { %><tr>
          <td><a href="/admin/users?q=<%= encodeURIComponent(row.used_by || "") %>"><%= userLabel(row, "claimant") %></a><div class="inviteId"><%= row.used_by || "" %></div></td>
          <td><a href="/admin/users?q=<%= encodeURIComponent(row.created_by || "") %>"><%= userLabel(row, "creator") %></a><div class="inviteId"><%= row.created_by || "" %></div></td>
          <td><code><%= row.code_plain || "Legacy" %></code></td>
          <td><time datetime="<%= new Date(row.used_at).toISOString() %>"><%= new Date(row.used_at).toLocaleString() %></time></td>
        </tr><% } %>
        <% if (!claimedInvites.length) { %><tr><td colspan="4" class="inviteEmpty">No invites have been claimed yet.</td></tr><% } %>
      </tbody>
    </table></div>
    <% if (claimedPages > 1) { %><nav class="invitePager" aria-label="Claimed invite pages">
      <% if (claimedPage > 1) { %><a href="<%= invitePageUrl(openPage, claimedPage - 1) %>">Previous</a><% } %>
      <span>Page <%= claimedPage %> of <%= claimedPages %></span>
      <% if (claimedPage < claimedPages) { %><a href="<%= invitePageUrl(openPage, claimedPage + 1) %>">Next</a><% } %>
    </nav><% } %>
  </section>

  <% if (removedInvites.length) { %><details class="inviteSection inviteRemoved">
    <summary>Removed invites (<%= inviteStats.removed %>)</summary>
    <div class="inviteTableWrap"><table class="inviteTable">
      <thead><tr><th>Code</th><th>Generated by</th><th>Status</th><th>Removed</th></tr></thead>
      <tbody><% for (const row of removedInvites) { const removedAt = row.deleted_at || row.revoked_at; %><tr>
        <td><code><%= row.code_plain || "Legacy" %></code></td>
        <td><%= userLabel(row, "creator") %><div class="inviteId"><%= row.created_by || "" %></div></td>
        <td><%= row.deleted_at ? "Deleted by admin" : (row.revoked_reason || "Revoked") %></td>
        <td><%= removedAt ? new Date(removedAt).toLocaleString() : "" %></td>
      </tr><% } %></tbody>
    </table></div>
  </details><% } %>
</body>

<%- include("inv_scripts") %>
</html>
