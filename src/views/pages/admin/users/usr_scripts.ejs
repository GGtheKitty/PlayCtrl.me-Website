<script>
  (function() {
    const qEl = document.getElementById('q');
    const sortEl = document.getElementById('sort');
    const dirEl = document.getElementById('dir');
    const pageEl = document.getElementById('pageSel');
    const pageEl2 = document.getElementById('pageSel2');
    const applyBtn = document.getElementById('apply');
    const go2 = document.getElementById('go2');

    function showToast(message, type) {
      if (!message) return;
      if (window.showToast) {
        window.showToast(message, { type: type || 'info' });
        return;
      }
      window.alert(message);
    }

    function apply(pageOverride) {
      const params = new URLSearchParams(window.location.search);
      const q = (qEl.value || '').trim();
      const sort = (sortEl.value || '').trim();
      const dir = (dirEl.value || 'desc').trim();

      if (q) params.set('q', q);
      else params.delete('q');
      if (sort) params.set('sort', sort);
      else params.delete('sort');
      if (dir) params.set('dir', dir);
      else params.delete('dir');

      params.set('page', String(pageOverride || pageEl.value || 1));
      window.location.search = params.toString();
    }

    applyBtn.addEventListener('click', () => apply(1));
    pageEl.addEventListener('change', () => apply(pageEl.value));
    pageEl2.addEventListener('change', () => apply(pageEl2.value));
    go2.addEventListener('click', () => apply(pageEl2.value));

    async function post(path, body) {
      const res = await fetch(path, {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        body: new URLSearchParams(body).toString(),
        credentials: "include"
      });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data || !data.ok) throw new Error((data && data.message) || ("HTTP " + res.status));
      return data;
    }

    document.addEventListener('click', async (e) => {
      const editBtn = e.target.closest('[data-edit]');
      const saveBtn = e.target.closest('[data-save]');
      const cancelBtn = e.target.closest('[data-cancel]');
      const supporterToggleBtn = e.target.closest('[data-supporter-toggle]');
      const clearQueueBtn = e.target.closest('[data-clear-queue]');

      function syncSupporterToggle(btn, enabled) {
        if (!btn) return;
        const on = !!enabled;
        btn.setAttribute('data-enabled', on ? '1' : '0');
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        btn.classList.toggle('isOn', on);
      }

      if (supporterToggleBtn) {
        const nextEnabled = supporterToggleBtn.getAttribute('data-enabled') !== '1';
        syncSupporterToggle(supporterToggleBtn, nextEnabled);
        return;
      }

      if (clearQueueBtn) {
        const id = clearQueueBtn.getAttribute('data-clear-queue');
        const displayName = clearQueueBtn.getAttribute('data-display-name') || id || 'this user';
        const queueCount = parseInt(clearQueueBtn.getAttribute('data-queue-count') || '0', 10);
        const countLabel = Number.isFinite(queueCount) && queueCount > 0
          ? queueCount + ' queued command' + (queueCount === 1 ? '' : 's')
          : 'queued commands';

        if (!id) return;
        if (!confirm('Clear ' + countLabel + ' for ' + displayName + '?')) return;

        clearQueueBtn.disabled = true;
        try {
          const data = await post('/admin/users/' + encodeURIComponent(id) + '/queue/clear', {});
          showToast('Cleared ' + (data.clearedCount || 0) + ' queued command' + ((data.clearedCount || 0) === 1 ? '' : 's') + '.', 'success');
          setTimeout(() => location.reload(), 220);
        } catch (err) {
          showToast('Failed to clear queue: ' + (err && err.message ? err.message : String(err)), 'error');
          clearQueueBtn.disabled = false;
        }
        return;
      }

      if (editBtn) {
        const id = editBtn.getAttribute('data-edit');
        const row = document.querySelector('[data-edit-row="' + CSS.escape(id) + '"]');
        if (row) row.style.display = (row.style.display === 'none' || !row.style.display) ? 'flex' : 'none';
        return;
      }

      if (cancelBtn) {
        const id = cancelBtn.getAttribute('data-cancel');
        const row = document.querySelector('[data-edit-row="' + CSS.escape(id) + '"]');
        if (row) {
          const input = row.querySelector('[data-commands-input="1"]');
          const strikeInput = row.querySelector('[data-strike-input="1"]');
          const supporterToggleBtn = row.querySelector('[data-supporter-toggle]');
          const status = row.querySelector('[data-status]');
          if (input) input.value = input.getAttribute('data-original-value') || '0';
          if (strikeInput) {
            strikeInput.value = strikeInput.getAttribute('data-original-strike-value') || '0';
          }
          if (supporterToggleBtn) {
            syncSupporterToggle(
              supporterToggleBtn,
              supporterToggleBtn.getAttribute('data-original-enabled') === '1'
            );
          }
          if (status) status.textContent = '';
          row.style.display = 'none';
        }
        return;
      }

      if (saveBtn) {
        const id = saveBtn.getAttribute('data-save');
        const row = document.querySelector('[data-edit-row="' + CSS.escape(id) + '"]');
        if (!row) return;
        const input = row.querySelector('[data-commands-input="1"]');
        const strikeInput = row.querySelector('[data-strike-input="1"]');
        const supporterToggleBtn = row.querySelector('[data-supporter-toggle]');
        const status = row.querySelector('[data-status]');
        const val = parseInt(input.value, 10);
        const strikeVal = parseInt(strikeInput.value, 10);
        const hasSupporterBadge =
          supporterToggleBtn && supporterToggleBtn.getAttribute('data-enabled') === '1'
            ? '1'
            : '0';
        if (!Number.isFinite(val) || val < 0) {
          if (status) status.textContent = "Enter a valid number.";
          return;
        }
        if (!Number.isFinite(strikeVal) || strikeVal < 0 || strikeVal > 3) {
          if (status) status.textContent = "Strikes must be between 0 and 3.";
          return;
        }
        if (!confirm("Save changes for " + id + "?")) return;

        if (status) status.textContent = "Saving...";
        try {
          await post("/admin/users/set-commands", {
            discord_id: id,
            commands_sent_total: String(val),
            strike_count: String(strikeVal),
            has_supporter_badge: hasSupporterBadge
          });
          if (status) status.textContent = "Saved.";
          setTimeout(() => {
            if (status) status.textContent = "";
          }, 900);

          setTimeout(() => location.reload(), 250);
        } catch (err) {
          if (status) status.textContent = "Failed: " + (err && err.message ? err.message : String(err));
        }
      }
    });
  })();
</script>
