<!DOCTYPE html>
<html>

<body>
  <h1>Bans</h1>
  <p><a href="/admin">Back</a></p>

  <form method="GET" action="/admin/bans" style="margin:12px 0;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
    <input
      id="q"
      name="q"
      value="<%= q %>"
      placeholder="Search all users by name or Discord ID..."
      autocomplete="off"
      style="width:min(520px, 100%);padding:8px;"
    />
    <select name="status" style="padding:8px;">
      <option value="all" <%= status === "all" ? "selected" : "" %>>All users</option>
      <option value="banned" <%= status === "banned" ? "selected" : "" %>>Banned only</option>
      <option value="active" <%= status === "active" ? "selected" : "" %>>Not banned</option>
    </select>
    <button type="submit">Search</button>
    <% if (q || status !== "all") { %>
      <a href="/admin/bans">Clear</a>
    <% } %>
    <span style="opacity:.7;"><%= total %> result<%= total === 1 ? "" : "s" %></span>
  </form>

  <table border="1" cellpadding="8" cellspacing="0" style="width:100%;max-width:1100px;">
    <thead>
      <tr>
        <th></th>
        <th>User</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody id="tbody">
      <% for (const u of users) { %>
      <tr class="urow">
        <td style="width:44px;">
          <img
            src="<%= siteAvatarUrl(u, 64) %>"
            loading="lazy"
            decoding="async"
            alt=""
            style="width:32px;height:32px;border-radius:999px;"
          />
        </td>
        <td>
          <div style="font-weight:700;"><%= (u.global_name || u.username || "") %></div>
          <div style="font-family:monospace;font-size:12px;opacity:.75;"><%= (u.discord_id) %></div>
          <% if (!!u.banned) { %>
          <div style="font-size:12px;opacity:.75;margin-top:4px;">
            banned_at=<%= new Date(u.banned_at).toISOString() %>
            <% if (u.reason) { %>
            <br />reason=<%= (u.reason) %>
            <% } %>
          </div>
          <% } %>
        </td>
        <td style="width:360px;">
          <% if (!!u.banned) { %>
          <form method="POST" action="/admin/bans/unban" style="margin:0;">
            <input type="hidden" name="discord_id" value="<%= (u.discord_id) %>" />
            <input type="hidden" name="return_to" value="<%= returnTo %>" />
            <button type="submit">Unban</button>
          </form>
          <% } else { %>
          <form method="POST" action="/admin/bans/ban" style="margin:0;display:flex;gap:8px;align-items:center;">
            <input type="hidden" name="discord_id" value="<%= (u.discord_id) %>" />
            <input type="hidden" name="return_to" value="<%= returnTo %>" />
            <input name="reason" placeholder="Reason (optional)" style="width:240px;" />
            <button type="submit">Ban</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% } %>
      <% if (!users.length) { %>
      <tr>
        <td colspan="3" style="padding:24px;text-align:center;opacity:.7;">No users match this search.</td>
      </tr>
      <% } %>
    </tbody>
  </table>

  <nav aria-label="Bans pages" style="display:flex;gap:12px;align-items:center;margin:16px 0;">
    <% if (page > 1) { %><a href="<%= prevUrl %>">Previous</a><% } %>
    <span>Page <strong><%= page %></strong> of <strong><%= pages %></strong></span>
    <% if (page < pages) { %><a href="<%= nextUrl %>">Next</a><% } %>
  </nav>
</body>

<%- include("bans_scripts") %>

</html>
