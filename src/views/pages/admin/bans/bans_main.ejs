<!DOCTYPE html>
<html>

<body>
  <h1>Bans</h1>
  <p><a href="/admin">Back</a></p>

  <div style="margin:12px 0;">
    <input id="q" placeholder="Search users (name or id)..." style="width:520px;padding:8px;" />
    <span id="count" style="margin-left:10px;opacity:.7;"></span>
  </div>

  <table border="1" cellpadding="8" cellspacing="0" style="width:100%;max-width:1100px;">
    <thead>
      <tr>
        <th></th>
        <th>User</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody id="tbody">
      <% for (const u of users) { %>
      <tr class="urow" data-q="<%= ((u.discord_id + " " + (u.global_name || u.username || "") + " " + (u.username || "") + " " + (u.global_name||"")).toLowerCase()) %>">
        <td style="width:44px;">
          <img src="<%= discordAvatarUrl(u, 64) %>" style="width:32px;height:32px;border-radius:999px;" />
        </td>
        <td>
          <div style="font-weight:700;"><%= (u.global_name || u.username || "") %></div>
          <div style="font-family:monospace;font-size:12px;opacity:.75;"><%= (u.discord_id) %></div>
          <% if (!!u.banned) { %>
          <div style="font-size:12px;opacity:.75;margin-top:4px;">
            banned_at=<%= new Date(u.banned_at).toISOString() %>
            <% if (u.reason) { %>
            <br />reason=<%= (u.reason) %>
            <% } %>
          </div>
          <% } %>
        </td>
        <td style="width:360px;">
          <% if (!!u.banned) { %>
          <form method="POST" action="/admin/bans/unban" style="margin:0;">
            <input type="hidden" name="discord_id" value="<%= (u.discord_id) %>" />
            <button type="submit">Unban</button>
          </form>
          <% } else { %>
          <form method="POST" action="/admin/bans/ban" style="margin:0;display:flex;gap:8px;align-items:center;">
            <input type="hidden" name="discord_id" value="<%= (u.discord_id) %>" />
            <input name="reason" placeholder="Reason (optional)" style="width:240px;" />
            <button type="submit">Ban</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
</body>

<%- include("bans_scripts") %>

</html>