<div class="card" id="boardCard">
    <div class="cardHd" style="display:flex;align-items:center;justify-content:space-between;">
      <span>Message Board</span>
      <span class="muted" style="font-size:12px;">Owner posts only</span>
    </div>

    <div class="cardBd">

      <% if(viewerIsOwner) { %>
        <div class="boardComposer">
          <form id="boardForm" class="boardComposerInner">
            <input id="boardInput" name="body" class="boardInput" placeholder="Type here" maxlength="200" />
            <button id="boardSend" class="boardPostBtn" type="submit">Post</button>
          </form>
        </div>
        <div class="muted" id="boardStatus" style="margin-top:10px;"></div>
        <div style="height:12px;"></div>
      <% } else { %>
        <div class="muted" style="margin-bottom:12px;">Only the device owner can post.</div>
      <% } %>

      <div class="boardList" id="boardList" aria-label="Message board"></div>

    </div>
  </div>
