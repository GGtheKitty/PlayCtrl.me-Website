
<div class="card gridCard">
  <div class="cardHd"><%= LISTS.favorites.label %> / <%= LISTS.dislikes.label %></div>
  <div class="cardBd">
    <div class="pillBox controlSidePrefsWindow">
      <% if (favKeys.length || disKeys.length) { %>
        <% if (favKeys.length) { %>
          <div class="controlSidePrefsGroup">
            <div class="pillWrap" data-favorite-list="1">
              <% for (const k of favKeys) { %>
                <% const isTopFavorite = !!(topFavKeySet && topFavKeySet.has(k)); %>
                <div
                  class="pill pill--fav controlPrefPill"
                  title="<%= k %>"
                  data-favorite-chip="1"
                  data-item-key="<%= k %>"
                  data-top-favorite="<%= isTopFavorite ? '1' : '0' %>"
                >
                  <span><%= labelByKey.get(k) || k %></span>
                  <% if (viewerIsOwner) { %>
                    <button
                      class="topFavoriteStarBtn <%= isTopFavorite ? 'is-active' : '' %>"
                      type="button"
                      data-top-favorite-key="<%= k %>"
                      data-enabled="<%= isTopFavorite ? '1' : '0' %>"
                      aria-pressed="<%= isTopFavorite ? 'true' : 'false' %>"
                      aria-label="<%= isTopFavorite ? 'Remove from top favorites' : 'Make this a top favorite' %>"
                      title="<%= isTopFavorite ? 'Remove from top favorites' : 'Make this a top favorite' %>"
                    ></button>
                  <% } else if (isTopFavorite) { %>
                    <span class="topFavoriteStarMarker" aria-hidden="true"></span>
                  <% } %>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

        <% if (disKeys.length) { %>
          <div class="controlSidePrefsGroup">
            <div class="pillWrap">
              <% for (const k of disKeys) { %>
                <div class="pill pill--dis" title="<%= k %>">
                  <span>- <%= labelByKey.get(k) || k %></span>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div class="controlSidePrefsEmpty muted">No <%= LISTS.favorites.label.toLowerCase() %> or <%= LISTS.dislikes.label.toLowerCase() %> selected yet.</div>
      <% } %>
    </div>
    <% if (viewerIsOwner && favKeys.length) { %>
      <div
        id="topFavoriteStatus"
        class="muted controlSidePrefsStatus"
        data-top-favorites-limit="<%= Number(topFavoritesLimit || 3) %>"
        hidden
      ></div>
    <% } %>
  </div>
</div>
