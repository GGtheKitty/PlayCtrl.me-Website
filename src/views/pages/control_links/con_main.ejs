              <% if (canReportControlLink) { %>
                <template id="tpl_control_report">
                  <form
                    id="controlReportForm"
                    class="controlReportForm"
                    data-control-report-form="1"
                    action="/api/device/<%= encodeURIComponent(pairCode) %>/report"
                  >
                    <div class="muted controlReportIntro">
                      Choose the reason that best matches this report.
                    </div>

                    <div class="controlReportReasonList" role="radiogroup" aria-label="Reason for reporting">
                      <% (controlLinkReportReasonOptions || []).forEach((option, index) => { %>
                        <label class="controlReportReasonOption">
                          <input
                            type="radio"
                            name="reason"
                            value="<%= option.key %>"
                            <%= index === 0 ? "required" : "" %>
                          />
                          <span class="controlReportReasonBody">
                            <span class="controlReportReasonLabel"><%= option.label %></span>
                            <span class="muted controlReportReasonDescription"><%= option.description %></span>
                          </span>
                        </label>
                      <% }) %>
                    </div>

                    <div class="cmdField">
                      <label class="muted cmdFieldLabel" for="controlReportDetails">
                        Extra details (optional)
                      </label>
                      <textarea
                        id="controlReportDetails"
                        name="details"
                        maxlength="1000"
                        placeholder="Anything else admins should know?"
                      ></textarea>
                    </div>

                    <div class="controlReportActions">
                      <button type="submit">Send Report</button>
                      <div
                        data-control-report-status="1"
                        class="muted controlReportStatus"
                        aria-live="polite"
                      ></div>
                    </div>
                  </form>
                </template>
              <% } %>

