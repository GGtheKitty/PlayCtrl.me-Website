          </div>

          <div class="cmdField">
            <label class="muted cmdFieldLabel" for="controlThemeDisplayName">
              Custom display name
            </label>
            <input
              id="controlThemeDisplayName"
              name="displayName"
              maxlength="40"
              placeholder="<%= ownerUser?.global_name || ownerUser?.username || ownerId %>"
              value="<%= controlLinkCustomName || "" %>"
            />
            <div class="muted controlThemeHint">
              Leave blank to use your normal Discord name.
            </div>
          </div>

          <div class="cmdField">
            <label class="muted cmdFieldLabel" for="controlThemeAboutMe">
              About me
            </label>
            <textarea
              id="controlThemeAboutMe"
              class="controlThemeAboutMeInput"
              name="aboutMe"
              maxlength="500"
              placeholder="Tell people a little about yourself..."
            ><%= aboutMe || "" %></textarea>
            <div class="controlThemeTextareaMeta">
              <div class="muted controlThemeHint controlThemeHint--left">
                Markdown: *italics* #bold# -strikethrough- _underline_
              </div>
              <div
                id="controlThemeAboutMeCount"
                class="muted controlThemeCounter"
                aria-live="polite"
              >0/500</div>
            </div>
          </div>

          <div class="controlThemePicker" role="radiogroup" aria-label="Control link theme">
            <% for (const theme of controlLinkThemeOptions) { %>
              <label
                class="controlThemeSwatch controlThemeSwatch--<%= theme.key %>"
                title="<%= theme.label %>"
              >
                <input
                  type="radio"
                  name="theme"
                  value="<%= theme.key %>"
                  aria-label="<%= theme.label %>"
                  <%= controlLinkTheme === theme.key ? "checked" : "" %>
                />
                <span class="controlThemeDot"></span>
              </label>
            <% } %>
          </div>

          <div class="controlThemeActions">
            <button type="submit">Save Changes</button>
          </div>

          <div class="muted controlThemeStatus" id="controlThemeStatus"></div>
        </form>
      </template>

      <div
        id="avatarCropModal"
        class="avatarCropModal"
        hidden
        aria-hidden="true"
      >
        <div class="avatarCropBackdrop" data-avatar-crop-close="1"></div>

        <div
          class="avatarCropCard"
          role="dialog"
          aria-modal="true"
          aria-labelledby="avatarCropTitle"
        >
          <div class="avatarCropHd">
            <div>
              <div id="avatarCropTitle" class="avatarCropTitle">Crop Avatar</div>
              <div id="avatarCropSubtitle" class="muted avatarCropSubtitle">Drag to position and use the slider to zoom.</div>
            </div>
          </div>

          <div class="avatarCropBody">
            <div class="avatarCropStage">
              <div id="avatarCropViewport" class="avatarCropViewport">
                <img
                  id="avatarCropImage"
                  class="avatarCropImage"
                  alt=""
                  draggable="false"
                />
                <div class="avatarCropFrame" aria-hidden="true">
                  <div id="avatarCropSafeArea" class="avatarCropSafeArea" aria-hidden="true"></div>
                </div>
              </div>
            </div>

            <div class="avatarCropSidebar">
              <div id="avatarCropPreviewLabel" class="avatarCropPreviewLabel muted">Preview</div>
              <canvas
                id="avatarCropPreviewCanvas"
                class="avatarCropPreviewCanvas"
                width="160"
                height="160"
              ></canvas>

              <label class="avatarCropZoomField" for="avatarCropZoom">
                <span class="muted avatarCropZoomLabel">Zoom</span>
                <input
                  id="avatarCropZoom"
                  class="avatarCropZoom"
                  type="range"
                  min="0"
                  max="100"
                  step="1"
                  value="0"
                />
              </label>
            </div>
          </div>

          <div class="avatarCropActions">
            <div id="avatarCropStatus" class="muted avatarCropStatus"></div>
            <div class="avatarCropButtonRow">
              <button type="button" class="avatarCropCancelBtn" data-avatar-crop-close="1">Cancel</button>
              <button id="avatarCropConfirmBtn" type="button" class="avatarCropConfirmBtn">Use Avatar</button>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <%- include("../../common/favicon_badge_client") %>
  <%- include("con_scripts", { user }) %>

</body>

</html>
