<!doctype html>
<html lang="en">

<%
  function escapeControlAboutHtml(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function trimControlAboutLink(rawUrl, closingMarker) {
    let end = String(rawUrl || "").length;

    while (end > 0) {
      const ch = rawUrl[end - 1];
      if (/[.,!?;:]/.test(ch)) {
        end -= 1;
        continue;
      }

      if (ch === ")") {
        const body = rawUrl.slice(0, end - 1);
        const openCount = (body.match(/\(/g) || []).length;
        const closeCount = (body.match(/\)/g) || []).length;
        if (closeCount >= openCount) {
          end -= 1;
          continue;
        }
      }

      break;
    }

    if (closingMarker && rawUrl[end - 1] === closingMarker) {
      end -= 1;
    }

    return rawUrl.slice(0, Math.max(0, end));
  }

  function renderControlAboutLink(linkText) {
    const href = /^https?:\/\//i.test(linkText)
      ? linkText
      : `https://${linkText}`;

    return (
      `<a href="${escapeControlAboutHtml(href)}" target="_blank" rel="noopener noreferrer nofollow">` +
      `${escapeControlAboutHtml(linkText)}</a>`
    );
  }

  function renderControlAboutMarkup(value) {
    const source = String(value || "");
    const markerTags = {
      "*": "em",
      "#": "strong",
      "-": "s",
      "_": "u",
    };
    const linkPattern = /^(https?:\/\/[^\s<]+|www\.[^\s<]+)/i;

    function walk(startIndex, closingMarker) {
      let html = "";
      let index = startIndex;

      while (index < source.length) {
        const ch = source[index];

        if (ch === "\\") {
          const next = source[index + 1] || "";
          if (next && (markerTags[next] || next === "\\")) {
            html += escapeControlAboutHtml(next);
            index += 2;
            continue;
          }

          html += escapeControlAboutHtml(ch);
          index += 1;
          continue;
        }

        const linkMatch = source.slice(index).match(linkPattern);
        if (linkMatch && linkMatch[0]) {
          const linkText = trimControlAboutLink(linkMatch[0], closingMarker);
          if (linkText) {
            html += renderControlAboutLink(linkText);
            index += linkText.length;
            continue;
          }
        }

        if (closingMarker && ch === closingMarker) {
          return { html, index: index + 1, closed: true };
        }

        if (markerTags[ch]) {
          const nested = walk(index + 1, ch);

          if (nested.closed && nested.html.trim()) {
            const tag = markerTags[ch];
            html += `<${tag}>${nested.html}</${tag}>`;
            index = nested.index;
            continue;
          }

          html += escapeControlAboutHtml(ch) + nested.html;
          index = nested.index;
          continue;
        }

        html += escapeControlAboutHtml(ch);
        index += 1;
      }

      return { html, index, closed: false };
    }

    return walk(0, "").html;
  }

  const controlAboutRawText = String(aboutMe || "");
  const controlAboutHasText = !!controlAboutRawText.trim();
  const controlAboutMarkup = controlAboutHasText
    ? renderControlAboutMarkup(controlAboutRawText)
    : "";
  const controlPresenceStatus = String(
    presenceStatus || (anyOnline ? "online" : "offline"),
  ).trim() || "offline";
  const controlPresenceLabel =
    controlPresenceStatus === "online"
      ? "Online"
      : controlPresenceStatus === "away"
        ? "Away"
        : "Offline";
  const controlPresenceClass =
    controlPresenceStatus === "online"
      ? "statusPill--on"
      : controlPresenceStatus === "away"
        ? "statusPill--away"
        : "statusPill--off";
%>

<head>
  <%- include("../../common/favicon_links") %>
  <link rel="stylesheet" href="/css/control_link.css">
</head>

<body>
  <div
    id="controlPageRoot"
    class="fullBleed controlPage"
    data-control-theme="<%= controlLinkTheme %>"
  >
    <div
      id="controlPageBackground"
      class="controlPageBackground"
      <% if (controlLinkShouldLoadCustomBackground) { %>
        style="background-image:url('<%= siteBackgroundUrl(ownerUser || { discord_id: ownerId }, 1920) %><%= controlLinkBackgroundVersion ? `&v=${encodeURIComponent(controlLinkBackgroundVersion)}` : "" %>')"
      <% } else { %>
        hidden
      <% } %>
    ></div>

    <div class="controlProfileWrap">
      <div class="card controlProfileCard">
        <div class="controlProfileBanner">
          <div
            id="controlBannerImage"
            class="controlProfileBannerImage"
            <% if (controlLinkHasCustomBanner) { %>
              style="background-image:url('<%= siteBannerUrl(ownerUser || { discord_id: ownerId }, 1600) %><%= controlLinkBannerVersion ? `&v=${encodeURIComponent(controlLinkBannerVersion)}` : "" %>')"
            <% } else { %>
              hidden
            <% } %>
          ></div>
          <div class="controlProfileBannerGlow"></div>
        </div>

        <div class="controlProfileBody">
          <div class="controlProfileAvatarWrap">
            <img
              id="controlAvatarImg"
              class="controlProfileAvatar"
              src="<%= siteAvatarUrl(ownerUser || { discord_id: ownerId }, 128) %><%= controlLinkAvatarVersion ? `&v=${encodeURIComponent(controlLinkAvatarVersion)}` : "" %>"
              alt=""
            />
          </div>

          <div class="controlProfileContent">
            <div class="controlProfileIdentityRow">
              <div class="controlProfileIdentity">
                <div class="controlProfileNameRow">
                  <span id="controlDisplayName" class="controlProfileDisplayName"><%= controlLinkDisplayName %></span>
                </div>
                <div class="controlProfileUsername muted">@<%= ownerUser?.username || "" %></div>
                <% if ((controlLinkBadges || []).length) { %>
                  <div class="controlProfileBadges" aria-label="Profile badges">
                    <% for (const badge of controlLinkBadges) { %>
                      <span
                        class="controlProfileBadge controlProfileBadge--<%= badge.kind %><%= badge.tier ? ` controlProfileBadge--tier-${badge.tier}` : '' %><%= badge.label ? '' : ' controlProfileBadge--icon-only' %>"
                        title="<%= badge.title %>"
                        aria-label="<%= badge.ariaLabel %>"
                      >
                        <span class="controlProfileBadgeIcon controlProfileBadgeIcon--<%= badge.icon || 'trophy' %>" aria-hidden="true"></span>
                        <% if (badge.label) { %>
                          <span class="controlProfileBadgeLabel"><%= badge.label %></span>
                        <% } %>
                      </span>
                    <% } %>
                  </div>
                <% } %>
              </div>

              <div class="controlProfileActionRow">
                <% if (viewerIsOwner) { %>
                  <button id="controlThemeEditBtn" class="controlEditBtn controlProfileActionBtn" type="button">
                    Edit
                  </button>
                <% } else { %>
                  <button class="favBtn controlProfileActionBtn <%= isFavorited ? 'isFav' : '' %>" data-discord-id="<%= ownerId %>" title="<%= isFavorited ? 'Click to remove from favorites' : 'Add to favorites' %>">
                    <%= isFavorited ? 'Favorited' : 'Add to Favorites' %>
                  </button>
                  <% if (canReportControlLink) { %>
                    <button
                      id="controlReportBtn"
                      class="controlReportBtn controlProfileActionBtn"
                      type="button"
                    >
                      Report
                    </button>
                  <% } %>
                <% } %>

                <div
                  id="statusPill"
                  class="statusPill <%= controlPresenceClass %>"
                  title="Live status"
                  data-presence-status="<%= controlPresenceStatus %>"
                >
                  <span class="statusDot"></span>
                  <span id="statusText"><%= controlPresenceLabel %></span>
                </div>
              </div>
            </div>

            <div
              id="controlAboutCard"
              class="controlProfileAbout <%= controlAboutHasText ? '' : 'controlProfileAbout--empty' %>"
            >
              <div id="controlAboutText" class="controlProfileAboutText"><% if (controlAboutHasText) { %><%- controlAboutMarkup %><% } else { %>This user hasn't added an About Me yet.<% } %></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="controlGrid">

      <div class="areaControls">
        <%
          const previewToggleEnabled = !!commandPreviewToggleEnabled;
          const previewDefaultMode = String(commandPreviewDefaultMode || "current").trim() || "current";
          const standardPreview = commandPreviewStandard || {};
          const whitelistedPreview = commandPreviewWhitelisted || {};
          const currentCanSendSubliminalMessage =
            typeof canSendSubliminalMessage === "undefined"
              ? false
              : !!canSendSubliminalMessage;

          function previewModeAttr(modeName, standardAllowed, whitelistedAllowed, currentAllowed) {
            if (!previewToggleEnabled) return currentAllowed ? "1" : "0";
            return modeName === "standard"
              ? (standardAllowed ? "1" : "0")
              : (whitelistedAllowed ? "1" : "0");
          }

          function previewVisibleByDefault(standardAllowed, whitelistedAllowed, currentAllowed) {
            if (!previewToggleEnabled) return !!currentAllowed;
            return previewDefaultMode === "standard"
              ? !!standardAllowed
              : !!whitelistedAllowed;
          }

          const previewCanPopup = previewToggleEnabled
            ? !!(standardPreview.canPopup || whitelistedPreview.canPopup)
            : !!canPopup;
          const previewCanSendSubliminalMessage = previewToggleEnabled
            ? !!(
                standardPreview.canSendSubliminalMessage ||
                whitelistedPreview.canSendSubliminalMessage
              )
            : currentCanSendSubliminalMessage;
          const previewCanImage = previewToggleEnabled
            ? !!(standardPreview.canImage || whitelistedPreview.canImage)
            : !!canImage;
          const previewCanFullscreenPopup = previewToggleEnabled
            ? !!(standardPreview.canFullscreenPopup || whitelistedPreview.canFullscreenPopup)
            : !!canFullscreenPopup;
          const previewCanSpiralOverlay = previewToggleEnabled
            ? !!(standardPreview.canSpiralOverlay || whitelistedPreview.canSpiralOverlay)
            : !!canSpiralOverlay;
          const previewCanOpenUrl = previewToggleEnabled
            ? !!(standardPreview.canOpenUrl || whitelistedPreview.canOpenUrl)
            : !!canOpenUrl;
          const previewCanSetWallpaper = previewToggleEnabled
            ? !!(standardPreview.canSetWallpaper || whitelistedPreview.canSetWallpaper)
            : !!canSetWallpaper;
          const previewCanPlaySound = previewToggleEnabled
            ? !!(standardPreview.canPlaySound || whitelistedPreview.canPlaySound)
            : !!canPlaySound;
          const previewCanPlaySoundLoop = previewToggleEnabled
            ? !!(standardPreview.canPlaySoundLoop || whitelistedPreview.canPlaySoundLoop)
            : !!canPlaySoundLoop;
          const previewCanWriteForMe = previewToggleEnabled
            ? !!(standardPreview.canWriteForMe || whitelistedPreview.canWriteForMe)
            : !!canWriteForMe;
          const previewCanScreenshot = previewToggleEnabled
            ? !!(standardPreview.canScreenshot || whitelistedPreview.canScreenshot)
            : !!canScreenshot;
          const previewCanWebcamCapture = previewToggleEnabled
            ? !!(standardPreview.canWebcamCapture || whitelistedPreview.canWebcamCapture)
            : !!canWebcamCapture;

          const standardCanSetWallpaperMedia = previewToggleEnabled
            ? !!standardPreview.canSetWallpaperMedia
            : !!canSetWallpaperMedia;
          const whitelistedCanSetWallpaperMedia = previewToggleEnabled
            ? !!whitelistedPreview.canSetWallpaperMedia
            : !!canSetWallpaperMedia;
          const standardWallpaperUploadContext = previewToggleEnabled
            ? String(standardPreview.setWallpaperUploadContext || "set_wallpaper")
            : String(setWallpaperUploadContext || "set_wallpaper");
          const whitelistedWallpaperUploadContext = previewToggleEnabled
            ? String(
                whitelistedPreview.setWallpaperUploadContext ||
                  standardWallpaperUploadContext ||
                  "set_wallpaper",
              )
            : String(setWallpaperUploadContext || "set_wallpaper");
          const standardCanPlaySoundUrl = previewToggleEnabled
            ? !!standardPreview.canPlaySoundUrl
            : !!canPlaySoundUrl;
          const whitelistedCanPlaySoundUrl = previewToggleEnabled
            ? !!whitelistedPreview.canPlaySoundUrl
            : !!canPlaySoundUrl;
          const standardCanPlaySoundLoopUrl = previewToggleEnabled
            ? !!standardPreview.canPlaySoundLoopUrl
            : !!canPlaySoundLoopUrl;
          const whitelistedCanPlaySoundLoopUrl = previewToggleEnabled
            ? !!whitelistedPreview.canPlaySoundLoopUrl
            : !!canPlaySoundLoopUrl;

          const previewDefaultHasCommands = previewToggleEnabled
            ? previewDefaultMode === "standard"
              ? !!standardPreview.anyCommandsEnabled
              : !!whitelistedPreview.anyCommandsEnabled
            : !!anyCommandsEnabled;
        %>
        <div class="card gridCard">
          <div class="cardHd">
            <span>Commands</span>
            <% if (previewToggleEnabled) { %>
              <div class="commandPreviewHeader">
                <div
                  class="commandPreviewTabs"
                  role="group"
                  aria-label="Command preview mode"
                  data-active-mode="<%= previewDefaultMode === "standard" ? "standard" : "whitelisted" %>"
                >
                  <span class="commandPreviewSlider" aria-hidden="true"></span>
                  <button
                    id="commandPreviewStandardBtn"
                    class="commandPreviewTab"
                    type="button"
                    data-command-preview-mode="standard"
                    data-active="<%= previewDefaultMode === "standard" ? "true" : "false" %>"
                    aria-pressed="<%= previewDefaultMode === "standard" ? "true" : "false" %>"
                  >
                    Standard
                  </button>
                  <button
                    id="commandPreviewWhitelistedBtn"
                    class="commandPreviewTab commandPreviewTab--accent"
                    type="button"
                    data-command-preview-mode="whitelisted"
                    data-active="<%= previewDefaultMode === "whitelisted" ? "true" : "false" %>"
                    aria-pressed="<%= previewDefaultMode === "whitelisted" ? "true" : "false" %>"
                  >
                    Whitelisted
                  </button>
                </div>
              </div>
            <% } %>
          </div>


          <div class="cardBd">
            <% if (anyCommandsEnabled) { %>
            <div class="controlsWrap" id="controlsWrap">

              <div class="cooldownOverlay" id="cooldownOverlay" data-show="false" aria-hidden="true">
                <div class="cooldownBox">
                  <div class="cooldownTitle">Please Wait</div>
                  <div class="cooldownNum"><span id="cooldownSeconds">3</span>s</div>
                  <div class="cooldownHint">
                    New users can send one command every 3 seconds
                  </div>
                </div>
              </div>

              <div class="cmdList" id="cmdList">
                <% if (previewCanPopup) { %>
                  <button
                    class="cmdBtn"
                    type="button"
                    data-command-preview-button="1"
                    data-cmd="popup"
                    data-tpl="tpl_cmd_popup"
                    data-tpl-standard="tpl_cmd_popup"
                    data-tpl-whitelisted="tpl_cmd_popup"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canPopup, whitelistedPreview.canPopup, canPopup) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canPopup, whitelistedPreview.canPopup, canPopup) %>"
                    <%= previewVisibleByDefault(standardPreview.canPopup, whitelistedPreview.canPopup, canPopup) ? "" : "hidden" %>
                  >
                    Send Message
                  </button>
                <% } %>

                <% if (previewCanSendSubliminalMessage) { %>
                  <button
                    class="cmdBtn"
                    type="button"
                    data-command-preview-button="1"
                    data-cmd="subliminal_message"
                    data-tpl="tpl_cmd_subliminal_message"
                    data-tpl-standard="tpl_cmd_subliminal_message"
                    data-tpl-whitelisted="tpl_cmd_subliminal_message"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canSendSubliminalMessage, whitelistedPreview.canSendSubliminalMessage, currentCanSendSubliminalMessage) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canSendSubliminalMessage, whitelistedPreview.canSendSubliminalMessage, currentCanSendSubliminalMessage) %>"
                    <%= previewVisibleByDefault(standardPreview.canSendSubliminalMessage, whitelistedPreview.canSendSubliminalMessage, currentCanSendSubliminalMessage) ? "" : "hidden" %>
                  >
                    Send Subliminal Message
                  </button>
                <% } %>

                <% if (previewCanImage) { %>
                  <button
                    class="cmdBtn"
                    type="button"
                    data-command-preview-button="1"
                    data-cmd="image_popup"
                    data-tpl="tpl_cmd_image_popup"
                    data-tpl-standard="tpl_cmd_image_popup"
                    data-tpl-whitelisted="tpl_cmd_image_popup"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canImage, whitelistedPreview.canImage, canImage) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canImage, whitelistedPreview.canImage, canImage) %>"
                    <%= previewVisibleByDefault(standardPreview.canImage, whitelistedPreview.canImage, canImage) ? "" : "hidden" %>
                  >
                    Send Image Popup
                  </button>
                <% } %>

                <% if (previewCanFullscreenPopup) { %>
                  <button
                    class="cmdBtn"
                    type="button"
                    data-command-preview-button="1"
                    data-cmd="fullscreen_popup"
                    data-tpl="tpl_cmd_fullscreen_popup"
                    data-tpl-standard="tpl_cmd_fullscreen_popup"
                    data-tpl-whitelisted="tpl_cmd_fullscreen_popup"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canFullscreenPopup, whitelistedPreview.canFullscreenPopup, canFullscreenPopup) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canFullscreenPopup, whitelistedPreview.canFullscreenPopup, canFullscreenPopup) %>"
                    <%= previewVisibleByDefault(standardPreview.canFullscreenPopup, whitelistedPreview.canFullscreenPopup, canFullscreenPopup) ? "" : "hidden" %>
                  >
                    Send Fullscreen Popup
                  </button>
                <% } %>

                <% if (previewCanSpiralOverlay) { %>
                  <button
                    class="cmdBtn"
                    type="button"
                    data-command-preview-button="1"
                    data-cmd="spiral_overlay"
                    data-tpl="tpl_cmd_spiral_overlay"
                    data-tpl-standard="tpl_cmd_spiral_overlay"
                    data-tpl-whitelisted="tpl_cmd_spiral_overlay"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canSpiralOverlay, whitelistedPreview.canSpiralOverlay, canSpiralOverlay) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canSpiralOverlay, whitelistedPreview.canSpiralOverlay, canSpiralOverlay) %>"
                    <%= previewVisibleByDefault(standardPreview.canSpiralOverlay, whitelistedPreview.canSpiralOverlay, canSpiralOverlay) ? "" : "hidden" %>
                  >
                    Spiral Overlay
                  </button>
                <% } %>

                <% if (previewCanOpenUrl) { %>
                  <button
                    class="cmdBtn"
                    type="button"
                    data-command-preview-button="1"
                    data-cmd="open_url"
                    data-tpl="tpl_cmd_open_url"
                    data-tpl-standard="tpl_cmd_open_url"
                    data-tpl-whitelisted="tpl_cmd_open_url"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canOpenUrl, whitelistedPreview.canOpenUrl, canOpenUrl) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canOpenUrl, whitelistedPreview.canOpenUrl, canOpenUrl) %>"
                    <%= previewVisibleByDefault(standardPreview.canOpenUrl, whitelistedPreview.canOpenUrl, canOpenUrl) ? "" : "hidden" %>
                  >
                    Open URL
                  </button>
                <% } %>

                <% if (previewCanSetWallpaper) { %>
                  <button
                    class="cmdBtn"
                    type="button"
                    data-command-preview-button="1"
                    data-cmd="set_wallpaper"
                    data-tpl="<%= canSetWallpaperMedia ? "tpl_cmd_set_wallpaper_whitelisted" : "tpl_cmd_set_wallpaper_standard" %>"
                    data-tpl-standard="tpl_cmd_set_wallpaper_standard"
                    data-tpl-whitelisted="tpl_cmd_set_wallpaper_whitelisted"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canSetWallpaper, whitelistedPreview.canSetWallpaper, canSetWallpaper) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canSetWallpaper, whitelistedPreview.canSetWallpaper, canSetWallpaper) %>"
                    <%= previewVisibleByDefault(standardPreview.canSetWallpaper, whitelistedPreview.canSetWallpaper, canSetWallpaper) ? "" : "hidden" %>
                  >
                    Set Wallpaper
                  </button>
                <% } %>

                <% if (previewCanPlaySound) { %>
                  <button
                    class="cmdBtn"
                    type="button"
                    data-command-preview-button="1"
                    data-cmd="play_sound"
                    data-tpl="<%= canPlaySoundUrl ? "tpl_cmd_play_sound_whitelisted" : "tpl_cmd_play_sound_standard" %>"
                    data-tpl-standard="tpl_cmd_play_sound_standard"
                    data-tpl-whitelisted="tpl_cmd_play_sound_whitelisted"
                    data-ps-url-enabled="<%= canPlaySoundUrl ? '1' : '0' %>"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canPlaySound, whitelistedPreview.canPlaySound, canPlaySound) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canPlaySound, whitelistedPreview.canPlaySound, canPlaySound) %>"
                    <%= previewVisibleByDefault(standardPreview.canPlaySound, whitelistedPreview.canPlaySound, canPlaySound) ? "" : "hidden" %>
                  >
                    Play Sound Effect
                  </button>
                <% } %>

                <% if (previewCanPlaySoundLoop) { %>
                  <button
                    class="cmdBtn"
                    type="button"
                    data-command-preview-button="1"
                    data-cmd="play_sound_loop"
                    data-tpl="<%= canPlaySoundLoopUrl ? "tpl_cmd_play_sound_loop_whitelisted" : "tpl_cmd_play_sound_loop_standard" %>"
                    data-tpl-standard="tpl_cmd_play_sound_loop_standard"
                    data-tpl-whitelisted="tpl_cmd_play_sound_loop_whitelisted"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canPlaySoundLoop, whitelistedPreview.canPlaySoundLoop, canPlaySoundLoop) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canPlaySoundLoop, whitelistedPreview.canPlaySoundLoop, canPlaySoundLoop) %>"
                    <%= previewVisibleByDefault(standardPreview.canPlaySoundLoop, whitelistedPreview.canPlaySoundLoop, canPlaySoundLoop) ? "" : "hidden" %>
                  >
                    Play Sound Loop
                  </button>
                <% } %>

                <% if (previewCanWriteForMe) { %>
                  <button
                    class="cmdBtn"
                    type="button"
                    data-command-preview-button="1"
                    data-cmd="write_for_me"
                    data-tpl="tpl_cmd_write_for_me"
                    data-tpl-standard="tpl_cmd_write_for_me"
                    data-tpl-whitelisted="tpl_cmd_write_for_me"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canWriteForMe, whitelistedPreview.canWriteForMe, canWriteForMe) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canWriteForMe, whitelistedPreview.canWriteForMe, canWriteForMe) %>"
                    <%= previewVisibleByDefault(standardPreview.canWriteForMe, whitelistedPreview.canWriteForMe, canWriteForMe) ? "" : "hidden" %>
                  >
                    Writing Prompt
                  </button>
                <% } %>

                <% if (previewCanScreenshot) { %>
                  <button
                    class="cmdBtn cmdBtn--instant"
                    type="button"
                    data-command-preview-button="1"
                    data-instant-cmd="screenshot"
                    data-live-only="1"
                    data-heavy="1"
                    data-action="/api/device/<%= encodeURIComponent(pairCode) %>/screenshot"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canScreenshot, whitelistedPreview.canScreenshot, canScreenshot) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canScreenshot, whitelistedPreview.canScreenshot, canScreenshot) %>"
                    <%= previewVisibleByDefault(standardPreview.canScreenshot, whitelistedPreview.canScreenshot, canScreenshot) ? "" : "hidden" %>
                    <% if (liveOnlyCommandsDisabled) { %>disabled aria-disabled="true" title="Only available while this user is online."<% } %>
                  >
                    Take Screenshot
                  </button>
                <% } %>

                <% if (previewCanWebcamCapture) { %>
                  <button
                    class="cmdBtn cmdBtn--instant"
                    type="button"
                    data-command-preview-button="1"
                    data-instant-cmd="webcam_capture"
                    data-live-only="1"
                    data-heavy="1"
                    data-action="/api/device/<%= encodeURIComponent(pairCode) %>/webcam_capture"
                    data-available-standard="<%= previewModeAttr("standard", standardPreview.canWebcamCapture, whitelistedPreview.canWebcamCapture, canWebcamCapture) %>"
                    data-available-whitelisted="<%= previewModeAttr("whitelisted", standardPreview.canWebcamCapture, whitelistedPreview.canWebcamCapture, canWebcamCapture) %>"
                    <%= previewVisibleByDefault(standardPreview.canWebcamCapture, whitelistedPreview.canWebcamCapture, canWebcamCapture) ? "" : "hidden" %>
                    <% if (liveOnlyCommandsDisabled) { %>disabled aria-disabled="true" title="Only available while this user is online."<% } %>
                  >
                    Webcam Capture
                  </button>
                <% } %>

              </div>

              <div
                id="commandPreviewEmpty"
                class="emptyState commandPreviewEmpty"
                <%= previewDefaultHasCommands ? "hidden" : "" %>
              >
                <div id="commandPreviewEmptyTitle" style="font-weight:900;">
                  <%= previewToggleEnabled
                    ? (previewDefaultMode === "standard"
                        ? "Standard list is empty"
                        : "Whitelisted list is empty")
                    : "Nothing enabled" %>
                </div>
                <div id="commandPreviewEmptyText" class="muted" style="margin-top:6px;">
                  <%= previewToggleEnabled
                    ? "No commands are currently available in this preview."
                    : "This user has disabled all commands." %>
                </div>
              </div>

              <!-- ========= Command Templates (modal loads these) ========= -->
