              <% function renderPlaySoundLoopForm(urlEnabled) { %>
                <form
                  class="cmdForm cmdFormPlaySound"
                  method="POST"
                  action="/api/device/<%= encodeURIComponent(pairCode) %>/play_sound_loop"
                  data-cmd="play_sound_loop"
                  data-ps-url-enabled="<%= urlEnabled ? '1' : '0' %>"
                >
                  <input type="hidden" name="kind" value="builtin" />
                  <input type="hidden" name="name" value="" />
                  <input type="hidden" name="url" value="" />

                  <div class="cmdField" style="margin-top:10px;">
                    <label class="muted cmdFieldLabel">Loop sound</label>
                    <select class="psSelect" style="width:100%;">
                      <option value="" selected>— Select a loop sound —</option>
                      <option value="__binaural_tone__">Binaural Tone</option>
                      <option value="clock.mp3">Clock</option>
                      <option value="bubbles.mp3">Bubbles</option>
                    </select>
                  </div>

                  <div class="cmdField psToneSettings" style="display:none;margin-top:10px;" hidden aria-hidden="true">
                    <label class="muted cmdFieldLabel">Binaural tone settings</label>
                    <div class="muted" style="margin-bottom:8px;">
                      The base frequency sets the tone pitch. The beat frequency sets the pulse speed.
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                      <label class="muted">
                        Base frequency (Hz)
                        <input class="psBaseHzInput" name="baseHz" type="number" min="0.01" step="any" value="440" />
                      </label>
                      <label class="muted">
                        Beat frequency (Hz)
                        <input class="psBeatHzInput" name="beatHz" type="number" min="0.01" step="any" value="4" />
                      </label>
                    </div>
                  </div>

                  <% if (urlEnabled) { %>
                    <div class="muted cmdDivider">or</div>
                    <div class="cmdField">
                      <label class="muted cmdFieldLabel">Enter URL here</label>
                      <input class="psUrlInput" placeholder="https://example.com/sound.mp3" />
                    </div>
                    <div class="muted cmdDivider">or</div>
                    <%- include("../../common/upload_panel", {
                      context: "play_sound",
                      targetSelector: ".psUrlInput",
                    }) %>
                  <% } %>

                  <div style="margin-top:12px;">
                    <button type="submit">Play Loop</button>
                  </div>
                </form>
              <% } %>

