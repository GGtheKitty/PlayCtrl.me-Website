  function initSubliminalMessageForm(form) {
    if (!form || form.dataset.subliminalInit === "1") return;
    form.dataset.subliminalInit = "1";

    const list = form.querySelector('[data-subliminal-message-list="1"]');
    const addBtn = form.querySelector('[data-subliminal-add="1"]');
    if (!list || !addBtn) return;

    addBtn.addEventListener("click", () => {
      const row = createSubliminalMessageRow();
      list.appendChild(row);
      row.querySelector("textarea")?.focus();
    });

    form.addEventListener("click", (e) => {
      const removeBtn = e.target?.closest?.('[data-subliminal-remove="1"]');
      if (!removeBtn) return;
      e.preventDefault();
      removeBtn.closest(".subliminalMessageRow")?.remove();
    });
  }

  function showCmdModal(title, templateId) {
    if (!cmdModal || !cmdModalBody || !cmdModalTitle) return;

    const tpl = document.getElementById(templateId);
    if (!tpl) return;

    cmdModalTitle.textContent = title || "Command";
    cmdModalBody.innerHTML = "";
    cmdModalBody.appendChild(tpl.content.cloneNode(true));

    cmdModal.style.display = "flex";
    cmdModal.setAttribute("aria-hidden", "false");

    const psForm = cmdModalBody.querySelector(
      'form.cmdForm[data-cmd="play_sound"], form.cmdForm[data-cmd="play_sound_loop"]',
    );
    if (psForm) initPlaySoundForm(psForm);
    const subliminalForm = cmdModalBody.querySelector(
      'form.cmdForm[data-cmd="subliminal_message"]',
    );
    if (subliminalForm) initSubliminalMessageForm(subliminalForm);
    const themeForm = cmdModalBody.querySelector('form[data-control-theme-form="1"]');
    if (themeForm) initControlThemeForm(themeForm);
    const reportForm = cmdModalBody.querySelector('form[data-control-report-form="1"]');
    if (reportForm) initControlReportForm(reportForm);
    initUploadPanels(cmdModalBody);

    const first = cmdModalBody.querySelector("textarea, input:not(.uploadInput), select, button, [data-upload-dropzone]");
    if (first && first.focus) first.focus();
  }

  function hideCmdModal() {
    if (!cmdModal || !cmdModalBody) return;
    closeAvatarCropModal();
    const hadThemeForm = !!cmdModalBody.querySelector('form[data-control-theme-form="1"]');
    if (hadThemeForm) applyControlTheme(activeControlTheme);
    if (window.stopUploadAudioPreview) window.stopUploadAudioPreview();
    cmdModalBody.innerHTML = "";
    cmdModal.style.display = "none";
    cmdModal.setAttribute("aria-hidden", "true");
