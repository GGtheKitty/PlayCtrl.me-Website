  (function(){
    const viewerIsOwner = <%- inlineScriptJson(!!viewerIsOwner) %>;
    const pairCode = <%- inlineScriptJson(pairCode) %>;

    let messages = <%- inlineScriptJson(boardMsgs || []) %>;
    let latestCreatedAt = messages.length ? Number(messages[0].created_at || 0) : 0;

    const toggleBtn = document.getElementById("boardToggle");
    const panelShell = document.getElementById("boardPanelShell");
    const panel = document.getElementById("boardPanel");
    const closeBtn = document.getElementById("boardPanelClose");
    const backdropBtn = document.getElementById("boardPanelBackdrop");
    const unreadBadge = document.getElementById("boardUnreadBadge");
    const listEl = document.getElementById("boardList");
    const form = document.getElementById("boardForm");
    const input = document.getElementById("boardInput");
    const statusEl = document.getElementById("boardStatus");
    const seenStorageKey = "board:lastSeen:" + pairCode;
    const boardBadgeSourceKey = "control-board:" + pairCode;

    let boardOpen = false;
    let lastSeenAt = 0;

    try {
      lastSeenAt = Number(localStorage.getItem(seenStorageKey) || 0) || 0;
    } catch {}

    function setStatus(t){ if (statusEl) statusEl.textContent = t || ""; }

    function relTime(ms){
      const s = Math.max(0, Math.floor((Date.now() - Number(ms || 0)) / 1000));
      if (s < 60) return s + "s ago";
      const m = Math.floor(s / 60);
      if (m < 60) return m + "m ago";
      const h = Math.floor(m / 60);
      if (h < 24) return h + "h ago";
      const d = Math.floor(h / 24);
      return d + " day" + (d === 1 ? "" : "s") + " ago";
    }

    function persistSeen(tsValue){
      const next = Number(tsValue || 0) || 0;
      if (!next) return;

      lastSeenAt = Math.max(lastSeenAt, next);
      try {
        localStorage.setItem(seenStorageKey, String(lastSeenAt));
      } catch {}
    }

    function unreadCount(){
      return messages.filter((msg) => Number(msg.created_at || 0) > lastSeenAt).length;
    }

    function renderUnreadBadge(){
      const count = boardOpen ? 0 : unreadCount();
      const hasUnread = count > 0;
      window.PlayCtrlTabBadge?.setSourceUnread(boardBadgeSourceKey, hasUnread);

      if (!toggleBtn || !unreadBadge) return;

      const label = hasUnread
        ? "Open message board, " + count + " unread"
        : "Open message board";

      toggleBtn.dataset.hasUnread = hasUnread ? "true" : "false";
      toggleBtn.setAttribute("aria-label", label);
      unreadBadge.hidden = !hasUnread;
      unreadBadge.textContent = count > 9 ? "9+" : String(count);
    }

    function markBoardSeen(){
      if (latestCreatedAt) persistSeen(latestCreatedAt);
      renderUnreadBadge();
    }

    function scrollBoardToBottom(){
      if (!listEl) return;

      requestAnimationFrame(() => {
        listEl.scrollTop = listEl.scrollHeight;
      });
    }

    function setBoardOpen(nextOpen){
      if (!panelShell || !toggleBtn) return;

      boardOpen = !!nextOpen;
      panelShell.dataset.open = boardOpen ? "true" : "false";
      panelShell.setAttribute("aria-hidden", boardOpen ? "false" : "true");
      toggleBtn.setAttribute("aria-expanded", boardOpen ? "true" : "false");
      syncDockPanelOpenState();

      if (boardOpen) {
        document.dispatchEvent(
          new CustomEvent("controlDockPanelOpened", {
            detail: { panel: "board" },
          }),
        );
        markBoardSeen();
        setStatus("");
        if (viewerIsOwner && input && input.focus) input.focus();
        else if (panel && panel.focus) panel.focus();
        refresh({ forceRender: true });
      } else if (toggleBtn.focus) {
        toggleBtn.focus();
      }

      renderUnreadBadge();
    }

    function render({ scrollToBottom = false } = {}){
      if (!listEl) return;

      listEl.innerHTML = "";

      if (!messages || !messages.length){
        const empty = document.createElement("div");
        empty.className = "boardEmpty";
        empty.textContent = "No messages yet.";
        listEl.appendChild(empty);
        if (scrollToBottom) scrollBoardToBottom();
        return;
      }

      const ordered = [...messages].sort((a, b) => {
        return Number(a.created_at || 0) - Number(b.created_at || 0);
      });

      for (const msg of ordered){
        const row = document.createElement("div");
        row.className = "boardRow";

        const av = document.createElement("img");
        av.className = "boardAvatar";
        av.src = ownerAvatar;
        av.alt = "";

        const body = document.createElement("div");
        body.className = "boardBody";

        const bubble = document.createElement("div");
        bubble.className = "boardBubble";
        bubble.textContent = String(msg.body || "");

        const meta = document.createElement("div");
        meta.className = "boardMeta";
        meta.textContent = relTime(msg.created_at);

        body.appendChild(bubble);
        body.appendChild(meta);

        row.appendChild(av);
        row.appendChild(body);

        listEl.appendChild(row);
      }

      if (scrollToBottom) scrollBoardToBottom();
    }

    async function refresh({ forceRender = false } = {}){
      try{
        const res = await fetch("/api/device/" + encodeURIComponent(pairCode) + "/board", {
          headers: { "Accept":"application/json" },
          credentials: "include"
        });
        const data = await res.json().catch(()=>null);
        if (!res.ok || !data || !data.ok) {
          console.warn("[board] refresh not ok", res.status, data);
          return;
        }

        const nextMsgs = Array.isArray(data.messages) ? data.messages : [];
        const nextLatest = Number(
          data.latest_created_at ||
          (nextMsgs[0] && nextMsgs[0].created_at) ||
          0
        );

        const changed =
          nextLatest !== latestCreatedAt ||
          nextMsgs.length !== messages.length;

        if (!changed && !forceRender) {
          if (boardOpen) markBoardSeen();
          return;
        }

        messages = nextMsgs;
        latestCreatedAt = nextLatest;
        render({ scrollToBottom: boardOpen || forceRender });

        if (boardOpen) markBoardSeen();
        else renderUnreadBadge();
      }catch(e){
        console.warn("[board] refresh error", e);
      }
    }

    if (panel && !panel.hasAttribute("tabindex")) {
      panel.setAttribute("tabindex", "-1");
    }

    toggleBtn?.addEventListener("click", () => setBoardOpen(!boardOpen));
    closeBtn?.addEventListener("click", () => setBoardOpen(false));
    backdropBtn?.addEventListener("click", () => setBoardOpen(false));
    document.addEventListener("controlDockPanelOpened", (e) => {
      if (e?.detail?.panel !== "board" && boardOpen) {
        setBoardOpen(false);
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && boardOpen) {
        e.preventDefault();
        setBoardOpen(false);
      }
    });

    window.addEventListener("storage", (e) => {
      if (e.key !== seenStorageKey) return;
      lastSeenAt = Number(e.newValue || 0) || 0;
      renderUnreadBadge();
    });

    window.addEventListener("pagehide", () => {
      window.PlayCtrlTabBadge?.clearSource(boardBadgeSourceKey);
    });

    if (viewerIsOwner && form && input){
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const body = (input.value || "").trim();
        if (!body) return;

        input.value = "";
        setStatus("Posting...");

        try{
          const res = await fetch("/api/device/" + encodeURIComponent(pairCode) + "/board", {
            method: "POST",
            headers: {
              "Accept":"application/json",
              "X-Requested-With":"XMLHttpRequest",
              "Content-Type":"application/x-www-form-urlencoded;charset=UTF-8"
            },
            body: new URLSearchParams({ body }).toString(),
            credentials: "include"
          });

          const data = await res.json().catch(()=>null);
          if (!res.ok || !data || !data.ok) throw new Error((data && (data.message || data.code)) || ("HTTP " + res.status));

          const nextMsgs = Array.isArray(data.messages) ? data.messages : [];
          messages = nextMsgs;
          latestCreatedAt = Number((nextMsgs[0] && nextMsgs[0].created_at) || latestCreatedAt || 0);

          render({ scrollToBottom: true });
          markBoardSeen();
          setStatus("Posted.");
          setTimeout(()=>setStatus(""), 900);
        }catch(err){
          setStatus("Failed to post.");
        }
      });
    }

    render({ scrollToBottom: true });
    renderUnreadBadge();

    refresh({ forceRender: true });
    setInterval(refresh, 2500);
    setInterval(() => {
      render();
      if (boardOpen) markBoardSeen();
      else renderUnreadBadge();
    }, 15000);
  })();

