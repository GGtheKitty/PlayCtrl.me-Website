  function getCommandPreviewAvailability(btn, mode = activeCommandPreviewMode) {
    if (!btn) return false;
    if (mode === "standard" && btn.hasAttribute("data-available-standard")) {
      return btn.getAttribute("data-available-standard") === "1";
    }
    if (
      mode === "whitelisted" &&
      btn.hasAttribute("data-available-whitelisted")
    ) {
      return btn.getAttribute("data-available-whitelisted") === "1";
    }
    return true;
  }

  function setCommandPreviewEmptyState(mode, visibleCount) {
    if (!commandPreviewEmpty) return;

    const hasVisibleCommands = Number(visibleCount || 0) > 0;
    commandPreviewEmpty.hidden = hasVisibleCommands;
    if (hasVisibleCommands) return;

    if (!commandPreviewEmptyTitle || !commandPreviewEmptyText) return;
    if (mode === "standard") {
      commandPreviewEmptyTitle.textContent = "Standard list is empty";
      commandPreviewEmptyText.textContent =
        "No commands are currently available to standard users.";
      return;
    }
    if (mode === "whitelisted") {
      commandPreviewEmptyTitle.textContent = "Whitelisted list is empty";
      commandPreviewEmptyText.textContent =
        "No commands are currently available to whitelisted users.";
      return;
    }

    commandPreviewEmptyTitle.textContent = "Nothing enabled";
    commandPreviewEmptyText.textContent =
      "This user has disabled all commands.";
  }

  function applyCommandPreviewMode(nextMode) {
    if (
      !controlViewerIsOwner ||
      !commandPreviewModeButtons.length ||
      !commandPreviewList
    ) {
      return;
    }

    activeCommandPreviewMode =
      nextMode === "standard" ? "standard" : "whitelisted";

    if (commandPreviewTabs) {
      commandPreviewTabs.setAttribute(
        "data-active-mode",
        activeCommandPreviewMode,
      );
    }

    let visibleCount = 0;
    commandPreviewList
      .querySelectorAll("[data-command-preview-button='1']")
      .forEach((btn) => {
        const visible = getCommandPreviewAvailability(
          btn,
          activeCommandPreviewMode,
        );
        btn.hidden = !visible;
        if (visible) visibleCount += 1;
      });

    commandPreviewModeButtons.forEach((btn) => {
      const mode = String(btn.getAttribute("data-command-preview-mode") || "")
        .trim();
      const active = mode === activeCommandPreviewMode;
      btn.setAttribute("data-active", active ? "true" : "false");
      btn.setAttribute("aria-pressed", active ? "true" : "false");
    });

    setCommandPreviewEmptyState(activeCommandPreviewMode, visibleCount);
  }

  function getResolvedCommandTemplateId(triggerEl) {
    if (!triggerEl) return "";
    if (activeCommandPreviewMode === "standard") {
      return (
        triggerEl.getAttribute("data-tpl-standard") ||
        triggerEl.getAttribute("data-tpl") ||
        ""
      );
    }
    if (activeCommandPreviewMode === "whitelisted") {
      return (
        triggerEl.getAttribute("data-tpl-whitelisted") ||
        triggerEl.getAttribute("data-tpl") ||
        ""
      );
    }
    return triggerEl.getAttribute("data-tpl") || "";
  }

  function getCommandPreviewRequestMode() {
    if (!controlViewerIsOwner) return "";
    return activeCommandPreviewMode === "standard" ||
