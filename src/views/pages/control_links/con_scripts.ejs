<% if (user) { %>
<script>
  const respBox = document.getElementById("respBox");
  const clearBtn = document.getElementById("clearResp");
  const pairCode = <%- inlineScriptJson(pairCode) %>;
  const controlPageRoot = document.getElementById("controlPageRoot");
  const controlPageBackgroundEl = document.getElementById("controlPageBackground");
  const controlAvatarImg = document.getElementById("controlAvatarImg");
  const controlBannerImageEl = document.getElementById("controlBannerImage");
  const controlAboutCard = document.getElementById("controlAboutCard");
  const controlAboutTextEl = document.getElementById("controlAboutText");
  const controlDisplayNameEl = document.getElementById("controlDisplayName");
  const topFavoriteList = document.querySelector("[data-favorite-list='1']");
  const topFavoriteStatus = document.getElementById("topFavoriteStatus");
  const ownerDiscordId = <%- inlineScriptJson(ownerId) %>;
  const defaultControlDisplayName = <%- inlineScriptJson(ownerUser?.global_name || ownerUser?.username || ownerId) %>;
  const emptyControlAboutText = "This user hasn't added an About Me yet.";
  const topFavoritesLimitMessage = "You can only have up to 3 favorites at a time";
  const topFavoritesLimit = Number(
    topFavoriteStatus?.getAttribute("data-top-favorites-limit") || 3,
  );
  let activeControlTheme = <%- inlineScriptJson(controlLinkTheme) %>;
  let activeControlDisplayName = <%- inlineScriptJson(controlLinkCustomName || "") %>;
  let activeControlAboutMe = <%- inlineScriptJson(aboutMe || "") %>;
  let activeControlAvatarVersion = <%- inlineScriptJson(Number(controlLinkAvatarVersion || 0)) %>;
  let activeControlHasCustomAvatar = <%- inlineScriptJson(!!controlLinkHasCustomAvatar) %>;
  let activeControlBannerVersion = <%- inlineScriptJson(Number(controlLinkBannerVersion || 0)) %>;
  let activeControlHasCustomBanner = <%- inlineScriptJson(!!controlLinkHasCustomBanner) %>;
  let activeControlBackgroundVersion = <%- inlineScriptJson(Number(controlLinkBackgroundVersion || 0)) %>;
  let activeControlHasCustomBackground = <%- inlineScriptJson(!!controlLinkHasCustomBackground) %>;
  const viewerDisablesCustomBackgrounds = <%- inlineScriptJson(!!viewerDisablesCustomBackgrounds) %>;
  let ownerAvatar = buildControlAvatarUrl(64, activeControlAvatarVersion);
  let topFavoriteBusy = false;

  function ts() {
    return new Date().toISOString();
  }

  function addLine(text, kind) {
    const row = document.createElement("div");
    row.className = "respRow";

    const time = document.createElement("div");
    time.className = "respBubble respTime";
    time.textContent = new Date().toLocaleTimeString([], {
      hour: "numeric",
      minute: "2-digit"
    });

    const msg = document.createElement("div");
    msg.className = "respBubble respMsg";
    msg.textContent = text;

    row.appendChild(time);
    row.appendChild(msg);

    respBox.prepend(row);
  }

  const cmdModal = document.getElementById("cmdModal");
  const cmdModalTitle = document.getElementById("cmdModalTitle");
  const cmdModalBody = document.getElementById("cmdModalBody");
  const controlViewerIsOwner = <%- inlineScriptJson(!!viewerIsOwner) %>;
  const commandPreviewList = document.getElementById("cmdList");
  const commandPreviewEmpty = document.getElementById("commandPreviewEmpty");
  const commandPreviewEmptyTitle = document.getElementById("commandPreviewEmptyTitle");
  const commandPreviewEmptyText = document.getElementById("commandPreviewEmptyText");
  const commandPreviewTabs = document.querySelector(".commandPreviewTabs");
  const commandPreviewModeButtons = Array.from(
    document.querySelectorAll("[data-command-preview-mode]"),
  );
  let activeCommandPreviewMode = <%- inlineScriptJson(
    commandPreviewToggleEnabled
      ? commandPreviewDefaultMode === "standard"
        ? "standard"
        : "whitelisted"
      : "current",
  ) %>;
  const boardDock = document.querySelector(".boardDock");
  const controlThemeEditBtn = document.getElementById("controlThemeEditBtn");
  const controlReportBtn = document.getElementById("controlReportBtn");
  const avatarCropModal = document.getElementById("avatarCropModal");
  const avatarCropTitle = document.getElementById("avatarCropTitle");
  const avatarCropSubtitle = document.getElementById("avatarCropSubtitle");
  const avatarCropPreviewLabel = document.getElementById("avatarCropPreviewLabel");
  const avatarCropViewport = document.getElementById("avatarCropViewport");
  const avatarCropImage = document.getElementById("avatarCropImage");
  const avatarCropZoom = document.getElementById("avatarCropZoom");
  const avatarCropPreviewCanvas = document.getElementById("avatarCropPreviewCanvas");
  const avatarCropStatus = document.getElementById("avatarCropStatus");
  const avatarCropConfirmBtn = document.getElementById("avatarCropConfirmBtn");

  function syncControlOverlayThemeVars(node) {
    if (!node || !node.style) return;
    node.style.setProperty("--control-accent-rgb", "var(--ctl-accent-rgb, 167, 139, 250)");
    node.style.setProperty("--control-accent-deep-rgb", "var(--ctl-accent-deep-rgb, 139, 92, 246)");
    node.style.setProperty("--control-accent-glow-rgb", "var(--ctl-accent-glow-rgb, 139, 92, 246)");
    node.style.setProperty("--control-surface-rgb", "var(--ctl-surface-rgb, 20, 20, 28)");
    node.style.setProperty("--control-surface-2-rgb", "var(--ctl-surface-2-rgb, 14, 14, 24)");
    node.style.setProperty("--control-panel-rgb", "var(--ctl-panel-rgb, 18, 18, 30)");
    node.style.setProperty("--control-panel-2-rgb", "var(--ctl-panel-2-rgb, 12, 12, 22)");
    node.style.setProperty("--control-accent-strong", "rgb(var(--control-accent-rgb))");
  }

  // Keep overlays out of the isolated control-page stacking context so they can cover the sticky topbar.
  function hoistOverlayToBody(node) {
    if (!node || !document.body || node.parentElement === document.body) return;
    syncControlOverlayThemeVars(node);
    document.body.appendChild(node);
  }

  syncControlOverlayThemeVars(cmdModal);
  syncControlOverlayThemeVars(avatarCropModal);
  syncControlOverlayThemeVars(boardDock);
  hoistOverlayToBody(boardDock);
  hoistOverlayToBody(cmdModal);
  hoistOverlayToBody(avatarCropModal);

  const CONTROL_CROP_MODES = Object.freeze({
    avatar: {
      kind: "avatar",
      title: "Crop Avatar",
      subtitle: "Drag to position and use the slider to zoom.",
      previewLabel: "Preview",
      confirmLabel: "Use Avatar",
      viewportWidth: 360,
      aspectRatio: 1,
      stageRadius: 24,
      frameInset: 18,
      frameRadius: 18,
      previewWidth: 160,
      previewHeight: 160,
      previewRadius: "999px",
      outputWidth: 512,
      outputHeight: 512,
    },
    banner: {
      kind: "banner",
      title: "Crop Banner",
      subtitle: "Keep important details inside the inner safe zone for mobile and header crops.",
      previewLabel: "Banner Preview",
      confirmLabel: "Use Banner",
      viewportWidth: 560,
      aspectRatio: 220 / 96,
      stageRadius: 20,
      frameInset: 14,
      frameRadius: 14,
      previewWidth: 220,
      previewHeight: 96,
      previewRadius: "18px",
      outputWidth: 1320,
      outputHeight: 576,
    },
  });
  let avatarCropState = null;
  let avatarCropDrag = null;
  let avatarCropRenderRaf = 0;

  function applyControlTheme(theme) {
    if (document.body) {
      document.body.classList.add("page-control-link");
      document.body.setAttribute("data-control-theme", theme || "purple");
    }
    if (!controlPageRoot) return;
    controlPageRoot.setAttribute("data-control-theme", theme || "purple");
  }

  function applyControlDisplayName(value) {
    if (!controlDisplayNameEl) return;
    controlDisplayNameEl.textContent = value || defaultControlDisplayName;
  }

  function escapeControlAboutHtml(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function trimControlAboutLink(rawUrl, closingMarker) {
    let end = String(rawUrl || "").length;

    while (end > 0) {
      const ch = rawUrl[end - 1];
      if (/[.,!?;:]/.test(ch)) {
        end -= 1;
        continue;
      }

      if (ch === ")") {
        const body = rawUrl.slice(0, end - 1);
        const openCount = (body.match(/\(/g) || []).length;
        const closeCount = (body.match(/\)/g) || []).length;
        if (closeCount >= openCount) {
          end -= 1;
          continue;
        }
      }

      break;
    }

    if (closingMarker && rawUrl[end - 1] === closingMarker) {
      end -= 1;
    }

    return rawUrl.slice(0, Math.max(0, end));
  }

  function renderControlAboutLink(linkText) {
    const href = /^https?:\/\//i.test(linkText)
      ? linkText
      : `https://${linkText}`;

    return (
      `<a href="${escapeControlAboutHtml(href)}" target="_blank" rel="noopener noreferrer nofollow">` +
      `${escapeControlAboutHtml(linkText)}</a>`
    );
  }

  function renderControlAboutMarkup(value) {
    const source = String(value || "");
    const markerTags = {
      "*": "em",
      "#": "strong",
      "-": "s",
      "_": "u",
    };
    const linkPattern = /^(https?:\/\/[^\s<]+|www\.[^\s<]+)/i;

    function walk(startIndex, closingMarker) {
      let html = "";
      let index = startIndex;

      while (index < source.length) {
        const ch = source[index];

        if (ch === "\\") {
          const next = source[index + 1] || "";
          if (next && (markerTags[next] || next === "\\")) {
            html += escapeControlAboutHtml(next);
            index += 2;
            continue;
          }

          html += escapeControlAboutHtml(ch);
          index += 1;
          continue;
        }

        const linkMatch = source.slice(index).match(linkPattern);
        if (linkMatch && linkMatch[0]) {
          const linkText = trimControlAboutLink(linkMatch[0], closingMarker);
          if (linkText) {
            html += renderControlAboutLink(linkText);
            index += linkText.length;
            continue;
          }
        }

        if (closingMarker && ch === closingMarker) {
          return { html, index: index + 1, closed: true };
        }

        if (markerTags[ch]) {
          const nested = walk(index + 1, ch);

          if (nested.closed && nested.html.trim()) {
            const tag = markerTags[ch];
            html += `<${tag}>${nested.html}</${tag}>`;
            index = nested.index;
            continue;
          }

          html += escapeControlAboutHtml(ch) + nested.html;
          index = nested.index;
          continue;
        }

        html += escapeControlAboutHtml(ch);
        index += 1;
      }

      return { html, index, closed: false };
    }

    return walk(0, "").html;
  }

  function applyControlAboutMe(value) {
    if (!controlAboutTextEl || !controlAboutCard) return;
    const text = String(value || "");
    const hasText = !!text.trim();
    if (hasText) {
      controlAboutTextEl.innerHTML = renderControlAboutMarkup(text);
    } else {
      controlAboutTextEl.textContent = emptyControlAboutText;
    }
    controlAboutCard.classList.toggle("controlProfileAbout--empty", !hasText);
  }

  function buildControlAvatarUrl(size, version) {
    const qs = new URLSearchParams({
      size: String(size || 64),
    });

    if (version) {
      qs.set("v", String(version));
    }

    return "/avatars/" + encodeURIComponent(ownerDiscordId) + "?" + qs.toString();
  }

  function buildControlBannerUrl(size, version) {
    const qs = new URLSearchParams({
      size: String(size || 1600),
    });

    if (version) {
      qs.set("v", String(version));
    }

    return "/banners/" + encodeURIComponent(ownerDiscordId) + "?" + qs.toString();
  }

  function buildControlBackgroundUrl(size, version) {
    const qs = new URLSearchParams({
      size: String(size || 1920),
    });

    if (version) {
      qs.set("v", String(version));
    }

    return "/backgrounds/" + encodeURIComponent(ownerDiscordId) + "?" + qs.toString();
  }

  function applyControlAvatar(version) {
    if (version) {
      activeControlAvatarVersion = Number(version) || Date.now();
    }

    const pageAvatarUrl = buildControlAvatarUrl(128, activeControlAvatarVersion);
    ownerAvatar = buildControlAvatarUrl(64, activeControlAvatarVersion);

    if (controlAvatarImg) {
      controlAvatarImg.src = pageAvatarUrl;
    }

    document.querySelectorAll(".boardAvatar").forEach((img) => {
      img.src = ownerAvatar;
    });
  }

  function applyControlBanner(version) {
    if (version) {
      activeControlBannerVersion = Number(version) || Date.now();
    }

    if (!controlBannerImageEl) return;

    if (!activeControlHasCustomBanner) {
      controlBannerImageEl.hidden = true;
      controlBannerImageEl.style.backgroundImage = "";
      return;
    }

    controlBannerImageEl.hidden = false;
    controlBannerImageEl.style.backgroundImage =
      "url('" + buildControlBannerUrl(1600, activeControlBannerVersion) + "')";
  }

  function applyControlBackground(version) {
    if (version) {
      activeControlBackgroundVersion = Number(version) || Date.now();
    }

    if (!controlPageBackgroundEl) return;

    if (!activeControlHasCustomBackground || viewerDisablesCustomBackgrounds) {
      controlPageBackgroundEl.hidden = true;
      controlPageBackgroundEl.style.backgroundImage = "";
      return;
    }

    controlPageBackgroundEl.hidden = false;
    controlPageBackgroundEl.style.backgroundImage =
      "url('" + buildControlBackgroundUrl(1920, activeControlBackgroundVersion) + "')";
  }

  function setTopFavoriteStatus(text, isError = false) {
    if (!topFavoriteStatus) return;
    const message = String(text || "").trim();
    topFavoriteStatus.textContent = message;
    topFavoriteStatus.hidden = !message;
    topFavoriteStatus.classList.toggle("isError", !!message && !!isError);
  }

  function setTopFavoriteBusyState(disabled) {
    topFavoriteBusy = !!disabled;
    if (!topFavoriteList) return;
    topFavoriteList
      .querySelectorAll("[data-top-favorite-key]")
      .forEach((btn) => {
        btn.disabled = topFavoriteBusy;
      });
  }

  function getActiveTopFavoriteCount() {
    if (!topFavoriteList) return 0;
    return topFavoriteList.querySelectorAll("[data-top-favorite='1']").length;
  }

  function applyTopFavoriteState(topFavoriteKeys, orderedFavoriteKeys) {
    if (!topFavoriteList) return;

    const topSet = new Set(
      Array.isArray(topFavoriteKeys)
        ? topFavoriteKeys.map((key) => String(key || "").trim()).filter(Boolean)
        : [],
    );
    const chips = Array.from(
      topFavoriteList.querySelectorAll("[data-favorite-chip='1']"),
    );
    const chipByKey = new Map();

    chips.forEach((chip) => {
      const key = String(chip.getAttribute("data-item-key") || "").trim();
      if (!key) return;
      chipByKey.set(key, chip);

      const isTopFavorite = topSet.has(key);
      chip.setAttribute("data-top-favorite", isTopFavorite ? "1" : "0");

      const btn = chip.querySelector("[data-top-favorite-key]");
      if (btn) {
        btn.classList.toggle("is-active", isTopFavorite);
        btn.setAttribute("data-enabled", isTopFavorite ? "1" : "0");
        btn.setAttribute("aria-pressed", isTopFavorite ? "true" : "false");
        btn.setAttribute(
          "aria-label",
          isTopFavorite
            ? "Remove from top favorites"
            : "Make this a top favorite",
        );
        btn.setAttribute(
          "title",
          isTopFavorite
            ? "Remove from top favorites"
            : "Make this a top favorite",
        );
      }
    });

    const orderedKeys = Array.isArray(orderedFavoriteKeys)
      ? orderedFavoriteKeys.map((key) => String(key || "").trim()).filter(Boolean)
      : [];

    orderedKeys.forEach((key) => {
      const chip = chipByKey.get(key);
      if (!chip) return;
      topFavoriteList.appendChild(chip);
      chipByKey.delete(key);
    });

    chipByKey.forEach((chip) => {
      topFavoriteList.appendChild(chip);
    });
  }

  function clamp(value, min, max) {
    const n = Number(value || 0);
    if (n < min) return min;
    if (n > max) return max;
    return n;
  }

  function setAvatarCropStatus(text) {
    if (avatarCropStatus) avatarCropStatus.textContent = text || "";
  }

  function isAvatarCropOpen() {
    return !!(avatarCropModal && !avatarCropModal.hidden);
  }

  function getAvatarCropViewportRect(configOverride = null) {
    const config = configOverride || avatarCropState?.config || CONTROL_CROP_MODES.avatar;
    const fallbackWidth = Number(config.viewportWidth || 360);
    const fallbackHeight = Math.max(
      96,
      Math.round(fallbackWidth / Number(config.aspectRatio || 1)),
    );

    if (!avatarCropViewport) {
      return { width: fallbackWidth, height: fallbackHeight };
    }

    return {
      width: Math.max(220, avatarCropViewport.clientWidth || fallbackWidth),
      height: Math.max(96, avatarCropViewport.clientHeight || fallbackHeight),
    };
  }

  function clampAvatarCropOffsets() {
    if (!avatarCropState) return;

    const viewportRect = getAvatarCropViewportRect(avatarCropState.config);
    const scaledWidth = avatarCropState.naturalWidth * avatarCropState.scale;
    const scaledHeight = avatarCropState.naturalHeight * avatarCropState.scale;
    const maxOffsetX = Math.max(0, (scaledWidth - viewportRect.width) / 2);
    const maxOffsetY = Math.max(0, (scaledHeight - viewportRect.height) / 2);

    avatarCropState.offsetX = clamp(
      avatarCropState.offsetX,
      -maxOffsetX,
      maxOffsetX,
    );
    avatarCropState.offsetY = clamp(
      avatarCropState.offsetY,
      -maxOffsetY,
      maxOffsetY,
    );
  }

  function getAvatarCropSourceRect() {
    if (!avatarCropState) return null;

    const viewportRect = getAvatarCropViewportRect(avatarCropState.config);
    const scale = avatarCropState.scale;
    const sourceWidth = Math.min(
      viewportRect.width / scale,
      avatarCropState.naturalWidth,
    );
    const sourceHeight = Math.min(
      viewportRect.height / scale,
      avatarCropState.naturalHeight,
    );

    const maxSourceX = Math.max(0, avatarCropState.naturalWidth - sourceWidth);
    const maxSourceY = Math.max(0, avatarCropState.naturalHeight - sourceHeight);

    const sx = clamp(
      avatarCropState.naturalWidth / 2 -
        sourceWidth / 2 -
        avatarCropState.offsetX / scale,
      0,
      maxSourceX,
    );
    const sy = clamp(
      avatarCropState.naturalHeight / 2 -
        sourceHeight / 2 -
        avatarCropState.offsetY / scale,
      0,
      maxSourceY,
    );

    return { sx, sy, sourceWidth, sourceHeight };
  }

  function renderAvatarCropPreview() {
    avatarCropRenderRaf = 0;
    if (!avatarCropState || !avatarCropPreviewCanvas) return;

    const canvas = avatarCropPreviewCanvas;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const cropRect = getAvatarCropSourceRect();
    if (!cropRect) return;

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = "high";
    ctx.drawImage(
      avatarCropState.image,
      cropRect.sx,
      cropRect.sy,
      cropRect.sourceWidth,
      cropRect.sourceHeight,
      0,
      0,
      canvas.width,
      canvas.height,
    );
  }

  function queueAvatarCropPreviewRender() {
    if (avatarCropRenderRaf) return;
    avatarCropRenderRaf = window.requestAnimationFrame(renderAvatarCropPreview);
  }

  function syncAvatarCropUi() {
    if (!avatarCropState || !avatarCropImage) return;

    clampAvatarCropOffsets();

    avatarCropImage.style.transform =
      "translate(-50%, -50%) translate(" +
      avatarCropState.offsetX +
      "px, " +
      avatarCropState.offsetY +
      "px) scale(" +
      avatarCropState.scale +
      ")";

    queueAvatarCropPreviewRender();
  }

  function closeAvatarCropModal(force = false) {
    const wasOpen = isAvatarCropOpen();
    if (!wasOpen || !avatarCropModal) return false;
    if (avatarCropState?.busy && !force) return true;

    avatarCropModal.hidden = true;
    avatarCropModal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("avatarCropOpen");
    avatarCropModal.classList.remove("avatarCropModal--banner");
    avatarCropModal.style.removeProperty("--crop-stage-width");
    avatarCropModal.style.removeProperty("--crop-stage-aspect");
    avatarCropModal.style.removeProperty("--crop-stage-radius");
    avatarCropModal.style.removeProperty("--crop-frame-inset");
    avatarCropModal.style.removeProperty("--crop-frame-radius");
    avatarCropModal.style.removeProperty("--crop-preview-width");
    avatarCropModal.style.removeProperty("--crop-preview-height");
    avatarCropModal.style.removeProperty("--crop-preview-radius");
    avatarCropState = null;
    avatarCropDrag = null;
    if (avatarCropImage) {
      avatarCropImage.removeAttribute("src");
      avatarCropImage.style.transform = "";
    }
    if (avatarCropTitle) avatarCropTitle.textContent = CONTROL_CROP_MODES.avatar.title;
    if (avatarCropSubtitle) avatarCropSubtitle.textContent = CONTROL_CROP_MODES.avatar.subtitle;
    if (avatarCropPreviewLabel) avatarCropPreviewLabel.textContent = CONTROL_CROP_MODES.avatar.previewLabel;
    if (avatarCropConfirmBtn) avatarCropConfirmBtn.textContent = CONTROL_CROP_MODES.avatar.confirmLabel;
    if (avatarCropRenderRaf) {
      window.cancelAnimationFrame(avatarCropRenderRaf);
      avatarCropRenderRaf = 0;
    }
    setAvatarCropStatus("");
    return true;
  }

  function openAvatarCropModal(file, image, onConfirm, options = {}) {
    if (
      !avatarCropModal ||
      !avatarCropViewport ||
      !avatarCropImage ||
      !avatarCropZoom ||
      !avatarCropConfirmBtn
    ) {
      throw new Error("Avatar cropper is not available.");
    }

    const cropMode =
      options.mode === "banner" ? CONTROL_CROP_MODES.banner : CONTROL_CROP_MODES.avatar;

    avatarCropModal.hidden = false;
    avatarCropModal.setAttribute("aria-hidden", "false");
    document.body.classList.add("avatarCropOpen");
    avatarCropModal.classList.toggle("avatarCropModal--banner", cropMode.kind === "banner");
    avatarCropModal.style.setProperty("--crop-stage-width", `${cropMode.viewportWidth}px`);
    avatarCropModal.style.setProperty("--crop-stage-aspect", String(cropMode.aspectRatio));
    avatarCropModal.style.setProperty("--crop-stage-radius", `${cropMode.stageRadius}px`);
    avatarCropModal.style.setProperty("--crop-frame-inset", `${cropMode.frameInset}px`);
    avatarCropModal.style.setProperty("--crop-frame-radius", `${cropMode.frameRadius}px`);
    avatarCropModal.style.setProperty("--crop-preview-width", `${cropMode.previewWidth}px`);
    avatarCropModal.style.setProperty("--crop-preview-height", `${cropMode.previewHeight}px`);
    avatarCropModal.style.setProperty("--crop-preview-radius", cropMode.previewRadius);
    if (avatarCropTitle) avatarCropTitle.textContent = cropMode.title;
    if (avatarCropSubtitle) avatarCropSubtitle.textContent = cropMode.subtitle;
    if (avatarCropPreviewLabel) avatarCropPreviewLabel.textContent = cropMode.previewLabel;
    if (avatarCropConfirmBtn) avatarCropConfirmBtn.textContent = cropMode.confirmLabel;
    if (avatarCropPreviewCanvas) {
      avatarCropPreviewCanvas.width = cropMode.previewWidth;
      avatarCropPreviewCanvas.height = cropMode.previewHeight;
    }

    const viewportRect = getAvatarCropViewportRect(cropMode);
    const minScale = Math.max(
      viewportRect.width / image.naturalWidth,
      viewportRect.height / image.naturalHeight,
    );

    avatarCropState = {
      file,
      image,
      config: cropMode,
      naturalWidth: image.naturalWidth,
      naturalHeight: image.naturalHeight,
      minScale,
      maxScale: Math.max(minScale * 4, minScale + 1),
      scale: minScale,
      offsetX: 0,
      offsetY: 0,
      onConfirm,
      busy: false,
    };

    avatarCropImage.src = image.src;
    avatarCropZoom.value = "0";
    setAvatarCropStatus("");
    avatarCropConfirmBtn.disabled = false;

    syncAvatarCropUi();
    avatarCropConfirmBtn.focus();
  }

  async function readFileAsDataUrl(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ""));
      reader.onerror = () => reject(new Error("Could not read that image."));
      reader.readAsDataURL(file);
    });
  }

  async function loadImageElement(dataUrl) {
    return new Promise((resolve, reject) => {
      const image = new Image();
      image.onload = () => resolve(image);
      image.onerror = () => reject(new Error("Could not load that image."));
      image.src = dataUrl;
    });
  }

