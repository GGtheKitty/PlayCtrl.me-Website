    e.preventDefault();
    avatarCropDrag = {
      pointerId: e.pointerId,
      startX: e.clientX,
      startY: e.clientY,
      originX: avatarCropState.offsetX,
      originY: avatarCropState.offsetY,
    };
    avatarCropViewport.setPointerCapture?.(e.pointerId);
  });

  avatarCropViewport?.addEventListener("pointermove", (e) => {
    if (!avatarCropState || !avatarCropDrag || avatarCropDrag.pointerId !== e.pointerId) {
