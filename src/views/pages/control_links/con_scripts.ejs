    async function uploadAvatarData(dataUrl, options = {}) {
      const filename = String(options.filename || "avatar-crop.png").trim() || "avatar-crop.png";
      const mime = String(options.mime || "image/png").trim() || "image/png";

      const res = await fetch("/api/device/" + encodeURIComponent(pairCode) + "/avatar", {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          filename,
          mime,
          data: dataUrl
        }),
        credentials: "include"
      });

      const data = await res.json().catch(() => null);
      if (!res.ok || !data || !data.ok) {
        throw new Error((data && (data.message || data.code)) || ("HTTP " + res.status));
      }

      activeControlAvatarVersion = Number(data.updatedAt || Date.now()) || Date.now();
      activeControlHasCustomAvatar = !!data.hasCustomAvatar;
      applyControlAvatar(activeControlAvatarVersion);
      renderAvatarControls();
    }

    async function uploadBannerData(dataUrl, options = {}) {
      const filename = String(options.filename || "banner-crop.png").trim() || "banner-crop.png";
