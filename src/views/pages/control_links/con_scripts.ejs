  function startHeavyCooldown() {
    const now = Date.now();
    heavyUntil = Math.max(heavyUntil, now + HEAVY_COOLDOWN_MS);

    setHeavyButtonsDisabled(true);

    if (heavyTimer) clearInterval(heavyTimer);
    heavyTimer = setInterval(() => {
      const left = heavyUntil - Date.now();
      if (left <= 0) {
        clearInterval(heavyTimer);
        heavyTimer = null;
        setHeavyButtonsDisabled(false);

        return;
      }

    }, 120);
  }

  function isHeavyCoolingDown() {
    return Date.now() < heavyUntil;
  }

  function startCooldown() {
    if (!COOLDOWN_APPLIES) return;

    const now = Date.now();
    nextAllowedAt = Math.max(nextAllowedAt, now + COOLDOWN_MS);

    setButtonsDisabled(true);
    showOverlay(nextAllowedAt - now);

    if (countdownTimer) clearInterval(countdownTimer);
    countdownTimer = setInterval(() => {
      const left = nextAllowedAt - Date.now();
      if (left <= 0) {
        clearInterval(countdownTimer);
        countdownTimer = null;
        hideOverlay();
        setButtonsDisabled(false);
        return;
