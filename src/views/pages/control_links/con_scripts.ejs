  function normalizeResponseItem(it) {
    const commandId =
      it?.commandId ??
      it?.command_id ??
      it?.id ??
      it?.cmdId ??
      it?.command?.commandId ??
      null;

    const createdAt =
      Number(it?.created_at ?? it?.createdAt ?? it?.ts ?? it?.time ?? 0) || 0;

    const details = it?.details ?? it?.payload ?? it?.data ?? null;

    const kind =
      it?.kind ??
      it?.type ??
      it?.response_type ??
      it?.responseType ??
      details?.kind ??
      details?.type ??
      null;

    const mime =
      it?.mime ??
      it?.content_type ??
      it?.contentType ??
      details?.mime ??
      details?.content_type ??
      null;

    const webpB64 =
      details?.webp_b64 ??
      details?.webpB64 ??
      it?.webp_b64 ??
      it?.webpB64 ??
      null;

    const url =
      it?.url ??
      it?.imageUrl ??
      it?.image_url ??
      details?.url ??
      details?.imageUrl ??
      null;

    const width = it?.width ?? details?.width ?? null;
    const height = it?.height ?? details?.height ?? null;
    const bytes = it?.bytes ?? details?.bytes ?? null;

    return { raw: it, commandId, createdAt, details, kind, mime, webpB64, url, width, height, bytes };
  }

  function isNewerThanBaseline(n) {
    if (n.commandId && lastSeenId && String(n.commandId) !== String(lastSeenId)) return true;
    if (n.createdAt && n.createdAt > lastSeenCreatedAt) return true;
    return false;
  }

  function markSeen(n) {
    if (!n) return;
