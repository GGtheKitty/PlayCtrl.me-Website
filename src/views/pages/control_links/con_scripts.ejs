  function initControlReportForm(form) {
    const statusEl = form.querySelector("[data-control-report-status='1']");
    const submitBtn = form.querySelector('button[type="submit"]');
    let busy = false;

    function setStatus(text, isError) {
      if (!statusEl) return;
      statusEl.textContent = text || "";
      statusEl.style.color = isError ? "rgba(251, 113, 133, 0.95)" : "";
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (busy) return;

      const formData = new FormData(form);
      const reason = String(formData.get("reason") || "").trim();

      if (!reason) {
        setStatus("Choose a reason before sending.", true);
        return;
      }

      busy = true;
      if (submitBtn) submitBtn.disabled = true;
      setStatus("Sending...");

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "X-Requested-With": "XMLHttpRequest",
            "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
          },
          body: new URLSearchParams(formData).toString(),
          credentials: "include",
        });

        const data = await res.json().catch(() => null);
        if (!res.ok || !data || !data.ok) {
          throw new Error((data && data.message) || ("HTTP " + res.status));
        }

        setStatus(data.message || "Report sent.");
        const commandHistoryEventId = String(
          form.dataset.commandHistoryEventId || "",
        ).trim();
        if (commandHistoryEventId) {
          document.dispatchEvent(
            new CustomEvent("commandHistoryReportSubmitted", {
              detail: {
                eventId: commandHistoryEventId,
                message: data.message || "Report sent.",
              },
            }),
          );
        }
        const submittedForm = form;
        window.setTimeout(() => {
          if (document.body.contains(submittedForm)) {
            hideCmdModal();
          }
        }, 700);
      } catch (err) {
        setStatus(
          (err && err.message) || "Could not send that report.",
          true,
        );
      } finally {
        busy = false;
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

