    const blockingEventIds = new Set();
    const likingEventIds = new Set();
    const actionStatusByEventId = new Map();

    if (!viewerIsOwner || !toggleBtn || !panelShell || !panel || !listEl) {
      return;
    }

    function formatLocalDateTime(value) {
      const ts = Number(value || 0);
      if (!Number.isFinite(ts) || ts <= 0) return "";

      try {
        return new Date(ts).toLocaleString([], {
          year: "numeric",
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit",
        });
      } catch {
        return new Date(ts).toLocaleString();
      }
    }

    function sortHistoryItems(items) {
      return (Array.isArray(items) ? items.slice() : []).sort((a, b) => {
        const at = Number(a?.createdAt || 0);
        const bt = Number(b?.createdAt || 0);
        if (at !== bt) return at - bt;
        return String(a?.id || "").localeCompare(String(b?.id || ""));
      });
    }

    function scrollHistoryToBottom() {
      window.requestAnimationFrame(() => {
        listEl.scrollTop = listEl.scrollHeight;
      });
    }

    function createHistoryField(
      label,
      value,
      { isMono = false, preserveWhitespace = false, url = "" } = {},
    ) {
      const field = document.createElement("div");
      field.className = "commandHistoryField";

      const labelEl = document.createElement("div");
      labelEl.className = "commandHistoryFieldLabel";
      labelEl.textContent = label;

      const valueEl = url
        ? document.createElement("a")
        : document.createElement("div");
      valueEl.className =
        "commandHistoryValue" +
        (isMono ? " commandHistoryValue--mono" : "") +
        (preserveWhitespace ? " commandHistoryValue--prewrap" : "");

      if (valueEl instanceof HTMLAnchorElement) {
        valueEl.classList.add("commandHistoryLink");
        valueEl.href = url;
        valueEl.target = "_blank";
        valueEl.rel = "noopener noreferrer nofollow";
      }

      valueEl.textContent = String(value || "");
      field.appendChild(labelEl);
      field.appendChild(valueEl);
      return field;
    }

    function formatHistoryGroupValue(item) {
      const groupKey = String(item?.groupKey || "").trim();
      const groupLabel = String(item?.groupLabel || "").trim();
      if (groupLabel && groupKey && groupLabel !== groupKey) {
        return `${groupLabel} (${groupKey})`;
      }
      return groupLabel || groupKey || "";
    }

    function applyHistoryActionState(card, eventId) {
      if (!card || !eventId) return;

      const likeBtn = card.querySelector('[data-command-history-action="like"]');
      const blockBtn = card.querySelector('[data-command-history-action="block"]');
      const reportBtn = card.querySelector('[data-command-history-action="report"]');
      const statusEl = card.querySelector('[data-command-history-status="1"]');
      const status = actionStatusByEventId.get(eventId) || null;

      if (likeBtn) {
        const canLike = likeBtn.dataset.canLike === "1";
        likeBtn.disabled =
          !canLike || likedEventIds.has(eventId) || likingEventIds.has(eventId);
        likeBtn.textContent = likedEventIds.has(eventId)
          ? "Liked"
          : likingEventIds.has(eventId)
            ? "Liking..."
            : "Like";
        likeBtn.dataset.liked = likedEventIds.has(eventId) ? "1" : "0";
      }

      if (blockBtn) {
        blockBtn.disabled =
          blockedEventIds.has(eventId) || blockingEventIds.has(eventId);
        blockBtn.textContent = blockedEventIds.has(eventId)
          ? "Blocked"
          : blockingEventIds.has(eventId)
            ? "Blocking..."
            : "Block";
      }

      if (reportBtn) {
        reportBtn.disabled = reportedEventIds.has(eventId);
        reportBtn.textContent = reportedEventIds.has(eventId)
          ? "Reported"
          : "Report";
      }

      if (statusEl) {
        statusEl.textContent = status?.text || "";
        statusEl.dataset.error = status?.isError ? "true" : "false";
      }
    }

    function renderHistoryItems(items) {
      listEl.innerHTML = "";

      const rows = sortHistoryItems(items);
      if (!rows.length) {
        const empty = document.createElement("div");
        empty.className = "boardEmpty";
        empty.textContent = "No received commands yet.";
        listEl.appendChild(empty);
        return;
      }

      rows.forEach((item) => {
        const eventId = String(item?.id || "").trim();
        if (eventId && item?.liked) {
          likedEventIds.add(eventId);
        }
        const card = document.createElement("article");
        card.className = "commandHistoryItem";
        if (eventId) {
          card.dataset.commandHistoryItemId = eventId;
        }

        const top = document.createElement("div");
        top.className = "commandHistoryItemTop";

        const typeEl = document.createElement("div");
        typeEl.className = "commandHistoryType";
        typeEl.textContent = String(item?.typeLabel || item?.type || "Command");

        const timeEl = document.createElement("time");
        timeEl.className = "commandHistoryTime";
        timeEl.dateTime = String(item?.createdIso || "");
        timeEl.textContent = formatLocalDateTime(item?.createdAt);

        top.appendChild(typeEl);
        top.appendChild(timeEl);

        const fields = document.createElement("div");
        fields.className = "commandHistoryFields";
        fields.appendChild(
          createHistoryField(
            "Command ID",
            String(item?.commandId || "Not logged"),
            { isMono: true },
          ),
        );

        const groupValue = formatHistoryGroupValue(item);
        if (groupValue) {
          fields.appendChild(
            createHistoryField("Group", groupValue, {
              isMono: !String(item?.groupLabel || "").trim(),
            }),
          );
        }

        const messages = Array.isArray(item?.messages)
          ? item.messages.filter((value) => String(value || "").trim())
          : [];
        if (messages.length > 1) {
          fields.appendChild(
            createHistoryField("Messages", messages.join("\n"), {
              preserveWhitespace: true,
            }),
          );
        } else if (item?.message) {
          fields.appendChild(
            createHistoryField("Message", String(item.message || "")),
          );
        }

        if (item?.url) {
          fields.appendChild(
            createHistoryField("URL", String(item.url || ""), {
              url: String(item.url || ""),
            }),
          );
        }

        card.appendChild(top);
        card.appendChild(fields);

        const actions = document.createElement("div");
        actions.className = "commandHistoryActions";

        const likeBtn = document.createElement("button");
        likeBtn.type = "button";
        likeBtn.className = "commandHistoryActionBtn commandHistoryActionBtn--like";
        likeBtn.dataset.commandHistoryAction = "like";
        likeBtn.dataset.eventId = eventId;
        likeBtn.dataset.canLike = item?.canLike ? "1" : "0";
        likeBtn.textContent = "Like";

        const blockBtn = document.createElement("button");
        blockBtn.type = "button";
        blockBtn.className = "commandHistoryActionBtn commandHistoryActionBtn--block";
        blockBtn.dataset.commandHistoryAction = "block";
        blockBtn.dataset.eventId = eventId;
        blockBtn.textContent = "Block";

        const reportBtn = document.createElement("button");
        reportBtn.type = "button";
        reportBtn.className = "commandHistoryActionBtn commandHistoryActionBtn--report";
        reportBtn.dataset.commandHistoryAction = "report";
        reportBtn.dataset.eventId = eventId;
        reportBtn.textContent = "Report";

        if (!eventId) {
          likeBtn.disabled = true;
          blockBtn.disabled = true;
          reportBtn.disabled = true;
        }

        actions.appendChild(likeBtn);
        actions.appendChild(blockBtn);
        actions.appendChild(reportBtn);
        card.appendChild(actions);

        const statusEl = document.createElement("div");
        statusEl.className = "commandHistoryActionStatus";
        statusEl.dataset.commandHistoryStatus = "1";
        statusEl.setAttribute("aria-live", "polite");
        card.appendChild(statusEl);

        applyHistoryActionState(card, eventId);
        listEl.appendChild(card);
      });
    }

    async function refreshHistory({ scrollToBottom = false } = {}) {
      if (isLoading) return;
      isLoading = true;

      listEl.innerHTML = "";
      const loading = document.createElement("div");
      loading.className = "boardEmpty";
      loading.textContent = "Loading command history...";
      listEl.appendChild(loading);

      try {
        const res = await fetch(
          "/api/device/" + encodeURIComponent(pairCode) + "/command-history",
          {
            headers: { "Accept": "application/json" },
            credentials: "include",
          },
        );
        const data = await res.json().catch(() => null);
        if (!res.ok || !data || !data.ok) {
          throw new Error((data && (data.message || data.code)) || ("HTTP " + res.status));
        }

        renderHistoryItems(data.items);
        if (scrollToBottom) {
          scrollHistoryToBottom();
        }
      } catch (err) {
        listEl.innerHTML = "";
        const empty = document.createElement("div");
        empty.className = "boardEmpty";
        empty.textContent = "Could not load command history.";
        listEl.appendChild(empty);
      } finally {
        isLoading = false;
      }
    }

    async function likeCommandHistoryEvent(eventId) {
      const safeEventId = String(eventId || "").trim();
      if (
        !safeEventId ||
        likedEventIds.has(safeEventId) ||
        likingEventIds.has(safeEventId)
      ) {
        return;
      }

      const card = listEl.querySelector(
        '[data-command-history-item-id="' + safeEventId + '"]',
      );
      likingEventIds.add(safeEventId);
      actionStatusByEventId.set(safeEventId, {
        text: "Liking command...",
        isError: false,
      });
      applyHistoryActionState(card, safeEventId);

      try {
        const res = await fetch(
          "/api/device/" +
            encodeURIComponent(pairCode) +
            "/command-history/" +
            encodeURIComponent(safeEventId) +
            "/like",
          {
            method: "POST",
            headers: {
              "Accept": "application/json",
              "X-Requested-With": "XMLHttpRequest",
            },
            credentials: "include",
          },
        );
        const data = await res.json().catch(() => null);
        if (!res.ok || !data || !data.ok) {
          throw new Error((data && data.message) || ("HTTP " + res.status));
        }

        likingEventIds.delete(safeEventId);
        likedEventIds.add(safeEventId);
        actionStatusByEventId.set(safeEventId, {
          text: data.message || "Command liked.",
          isError: false,
        });
      } catch (err) {
        likingEventIds.delete(safeEventId);
        actionStatusByEventId.set(safeEventId, {
          text: (err && err.message) || "Could not like that command.",
          isError: true,
        });
      }

      applyHistoryActionState(card, safeEventId);
    }

    async function blockSenderForHistoryEvent(eventId) {
      const safeEventId = String(eventId || "").trim();
      if (!safeEventId || blockingEventIds.has(safeEventId)) return;

      const confirmed = window.confirm(
        "Block this sender from sending you future commands? You still will not be shown who they are.",
      );
      if (!confirmed) return;

      const card = listEl.querySelector(
        '[data-command-history-item-id="' + safeEventId + '"]',
      );
      blockingEventIds.add(safeEventId);
      actionStatusByEventId.set(safeEventId, {
        text: "Blocking sender...",
        isError: false,
      });
      applyHistoryActionState(card, safeEventId);

      try {
        const res = await fetch(
          "/api/device/" +
            encodeURIComponent(pairCode) +
            "/command-history/" +
            encodeURIComponent(safeEventId) +
            "/block",
          {
            method: "POST",
            headers: {
              "Accept": "application/json",
              "X-Requested-With": "XMLHttpRequest",
            },
            credentials: "include",
          },
        );
        const data = await res.json().catch(() => null);
        if (!res.ok || !data || !data.ok) {
          throw new Error((data && data.message) || ("HTTP " + res.status));
        }

        blockingEventIds.delete(safeEventId);
        blockedEventIds.add(safeEventId);
        actionStatusByEventId.set(safeEventId, {
          text: data.message || "Future commands from this sender will be blocked.",
          isError: false,
        });
      } catch (err) {
        blockingEventIds.delete(safeEventId);
        actionStatusByEventId.set(safeEventId, {
          text: (err && err.message) || "Could not block that sender.",
          isError: true,
        });
      }

      applyHistoryActionState(card, safeEventId);
    }

    function openCommandHistoryReportModal(eventId) {
      const safeEventId = String(eventId || "").trim();
      if (!safeEventId || reportedEventIds.has(safeEventId)) return;

      showCmdModal("Report Sender", "tpl_command_history_report");
      const form = cmdModalBody?.querySelector(
        "form[data-command-history-report-form='1']",
      );
      if (!form) return;

      form.action =
        "/api/device/" +
        encodeURIComponent(pairCode) +
        "/command-history/" +
        encodeURIComponent(safeEventId) +
        "/report";
      form.dataset.commandHistoryEventId = safeEventId;
    }

    function setPanelOpen(nextOpen) {
      panelOpen = !!nextOpen;
      panelShell.dataset.open = panelOpen ? "true" : "false";
      panelShell.setAttribute("aria-hidden", panelOpen ? "false" : "true");
      toggleBtn.setAttribute("aria-expanded", panelOpen ? "true" : "false");
      syncDockPanelOpenState();

      if (panelOpen) {
        document.dispatchEvent(
          new CustomEvent("controlDockPanelOpened", {
            detail: { panel: "history" },
          }),
        );
        refreshHistory({ scrollToBottom: true });
        if (panel && panel.focus) panel.focus();
      } else if (toggleBtn.focus) {
        toggleBtn.focus();
      }
    }

    if (panel && !panel.hasAttribute("tabindex")) {
      panel.setAttribute("tabindex", "-1");
    }

    toggleBtn.addEventListener("click", () => setPanelOpen(!panelOpen));
    closeBtn?.addEventListener("click", () => setPanelOpen(false));
    backdropBtn?.addEventListener("click", () => setPanelOpen(false));
    listEl.addEventListener("click", (event) => {
      const btn = event.target?.closest?.("[data-command-history-action]");
      if (!btn) return;

      event.preventDefault();

      const action = String(btn.dataset.commandHistoryAction || "").trim();
      const eventId = String(btn.dataset.eventId || "").trim();
      if (!eventId) return;

      if (action === "like") {
        likeCommandHistoryEvent(eventId);
        return;
      }

      if (action === "block") {
        blockSenderForHistoryEvent(eventId);
        return;
      }

      if (action === "report") {
        openCommandHistoryReportModal(eventId);
      }
    });
    document.addEventListener("controlDockPanelOpened", (e) => {
      if (e?.detail?.panel !== "history" && panelOpen) {
        setPanelOpen(false);
      }
    });
    document.addEventListener("commandHistoryReportSubmitted", (event) => {
      const eventId = String(event?.detail?.eventId || "").trim();
      if (!eventId) return;

      reportedEventIds.add(eventId);
      actionStatusByEventId.set(eventId, {
        text: String(event?.detail?.message || "Report sent."),
        isError: false,
      });

      const card = listEl.querySelector(
        '[data-command-history-item-id="' + eventId + '"]',
      );
      applyHistoryActionState(card, eventId);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && panelOpen) {
        e.preventDefault();
        setPanelOpen(false);
      }
    });
  })();

  async function toggleFav(btn) {
    const id = btn.dataset.discordId;
    btn.disabled = true;

    try {
      const res = await fetch("/favorites/toggle", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ discordId: id })
      });

      const j = await res.json();
      if (!j.ok) {
        if (j.error === "not_logged_in") location.href = "/login";
        throw new Error(j.error || "failed");
      }

      const isFav = !!j.favorited;
      btn.classList.toggle("isFav", isFav);
      btn.textContent = isFav ? "Favorited" : "Add to Favorites";
      btn.title = isFav ? "Click to remove from favorites" : "Add to favorites";
    } catch (e) {
      console.error(e);
      alert("Could not update favorite.");
    } finally {
      btn.disabled = false;
    }
  }

  document.addEventListener("click", (e) => {
    const btn = e.target.closest(".favBtn");
    if (!btn) return;
    e.preventDefault();
    toggleFav(btn);
  });

  const BINAURAL_TONE_OPTION = "__binaural_tone__";

  function initPlaySoundForm(form) {
    const urlEnabled = form.dataset.psUrlEnabled === "1";

    const select = form.querySelector(".psSelect");
    const urlInput = form.querySelector(".psUrlInput");
    const baseHzInput = form.querySelector(".psBaseHzInput");
    const beatHzInput = form.querySelector(".psBeatHzInput");
    const toneSettings = form.querySelector(".psToneSettings");

    const hidKind = form.querySelector('input[type="hidden"][name="kind"]');
    const hidName = form.querySelector('input[type="hidden"][name="name"]');
    const hidUrl  = form.querySelector('input[type="hidden"][name="url"]');

    function syncLoopSoundFields() {
      if (form.dataset.cmd !== "play_sound_loop" || !toneSettings) return;
      const hasUrl = urlEnabled && String(urlInput?.value || "").trim();
      const toneSelected = !hasUrl && select?.value === BINAURAL_TONE_OPTION;
      toneSettings.hidden = !toneSelected;
      toneSettings.style.display = toneSelected ? "" : "none";
      toneSettings.setAttribute("aria-hidden", toneSelected ? "false" : "true");
    }

    select?.addEventListener("change", () => {
      if (select.value && urlInput) urlInput.value = "";
      syncLoopSoundFields();
    });
    urlInput?.addEventListener("input", () => {
      if (String(urlInput.value || "").trim() && select) select.value = "";
      syncLoopSoundFields();
    });
    syncLoopSoundFields();

    form.addEventListener("submit", (e) => {
      const selected = String(select?.value || "").trim();
      const typedUrl = urlEnabled ? String(urlInput?.value || "").trim() : "";

      if (urlEnabled && typedUrl) {
        hidKind.value = "url";
        hidUrl.value = typedUrl;
        hidName.value = "";
        return;
      }

      if (selected === BINAURAL_TONE_OPTION) {
        const baseHz = Number(baseHzInput?.value);
        const beatHz = Number(beatHzInput?.value);
        if (Number.isFinite(baseHz) && baseHz > 0 && Number.isFinite(beatHz) && beatHz > 0) {
          hidKind.value = "tone";
          hidName.value = "";
          hidUrl.value = "";
          return;
        }
        e.preventDefault();
        addLine("Enter positive base and beat frequencies.", "error");
        return;
      }

      if (selected) {
        hidKind.value = "builtin";
        hidName.value = selected;
        hidUrl.value = "";
        return;
      }

      e.preventDefault();
      addLine(
        form.dataset.cmd === "play_sound_loop"
          ? "Select a loop sound, or enter a URL."
          : "Pick a built-in sound, or enter a URL.",
        "error",
      );
    });
  }

  (function () {
    function normalize(s) {
      return String(s || "").trim();
    }

    document.addEventListener(
      "submit",
      (e) => {
        const form = e.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (form.dataset.cmd !== "play_sound" && form.dataset.cmd !== "play_sound_loop") return;

        if (!form.classList.contains("cmdFormPlaySound")) return;

        const sel = form.querySelector(".psSelect");
        const urlInput = form.querySelector(".psUrlInput");
        const baseHzInput = form.querySelector(".psBaseHzInput");
        const beatHzInput = form.querySelector(".psBeatHzInput");

        const selectedName = normalize(sel && "value" in sel ? sel.value : "");
        const url = normalize(urlInput && "value" in urlInput ? urlInput.value : "");

        const kindEl = form.querySelector('input[name="kind"]');
        const nameEl = form.querySelector('input[name="name"]');
        const urlEl = form.querySelector('input[name="url"]');

        const urlEnabled = form.dataset.psUrlEnabled === "1";

        if (urlEnabled && url) {
          if (kindEl) kindEl.value = "url";
          if (urlEl) urlEl.value = url;
          if (nameEl) nameEl.value = "";
        } else if (selectedName === BINAURAL_TONE_OPTION) {
          if (kindEl) kindEl.value = "tone";
          if (nameEl) nameEl.value = "";
          if (urlEl) urlEl.value = "";
        } else if (selectedName) {
          if (kindEl) kindEl.value = "builtin";
          if (nameEl) nameEl.value = selectedName;
          if (urlEl) urlEl.value = "";
        }

        const finalKind = kindEl ? kindEl.value : "builtin";
        const finalName = nameEl ? normalize(nameEl.value) : "";
        const finalUrl = urlEl ? normalize(urlEl.value) : "";
        const finalBaseHz = Number(baseHzInput?.value);
        const finalBeatHz = Number(beatHzInput?.value);

        if (
          finalKind === "tone" &&
          (!Number.isFinite(finalBaseHz) || finalBaseHz <= 0 ||
            !Number.isFinite(finalBeatHz) || finalBeatHz <= 0)
        ) {
          e.preventDefault();
          addLine("Enter positive base and beat frequencies.", "error");
          return;
        }

        if (finalKind === "builtin" && !finalName) {
          e.preventDefault();
          addLine("Pick a built-in sound (or enter a URL).", "error");
          return;
        }

        if (finalKind === "url" && !finalUrl) {
          e.preventDefault();
          addLine("Enter a sound URL.", "error");
          return;
        }
      },
      true
    );
  })();
</script>
<% } %>
