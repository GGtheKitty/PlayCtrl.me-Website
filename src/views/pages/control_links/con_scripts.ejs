  (function() {
    const pill = document.getElementById("statusPill");
    const txt = document.getElementById("statusText");
    const liveOnlyButtons = Array.from(
      document.querySelectorAll("[data-live-only='1']")
    );
    if (!pill || !txt) return;

    function setLiveOnlyButtonsDisabled(disabled) {
      liveOnlyButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        if (disabled) {
          button.disabled = true;
          button.setAttribute("aria-disabled", "true");
          button.setAttribute("title", "Only available while this user is online.");
          button.dataset.awayDisabled = "1";
          return;
        }
        button.disabled = false;
        button.removeAttribute("aria-disabled");
        if (button.dataset.awayDisabled === "1") {
          button.removeAttribute("title");
          delete button.dataset.awayDisabled;
        }
      });
    }

    function setPresenceStatus(status) {
      const value = String(status || "").trim().toLowerCase();
      pill.classList.remove("statusPill--on", "statusPill--away", "statusPill--off");
      if (value === "online") {
        pill.classList.add("statusPill--on");
        txt.textContent = "Online";
        setLiveOnlyButtonsDisabled(false);
        return;
      }
      if (value === "away") {
        pill.classList.add("statusPill--away");
        txt.textContent = "Away";
        setLiveOnlyButtonsDisabled(true);
        return;
      }
      pill.classList.add("statusPill--off");
      txt.textContent = "Offline";
      setLiveOnlyButtonsDisabled(false);
