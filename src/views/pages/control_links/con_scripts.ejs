    function syncAboutMeCount() {
      if (!aboutMeInput) return;

      const maxLength = Number(aboutMeInput.getAttribute("maxlength") || 500) || 500;
      if (aboutMeInput.value.length > maxLength) {
        aboutMeInput.value = aboutMeInput.value.slice(0, maxLength);
      }

      if (aboutMeCountEl) {
        aboutMeCountEl.textContent = `${aboutMeInput.value.length}/${maxLength}`;
      }
    }

    function syncBusyState() {
      const disabled = saveBusy || avatarBusy || bannerBusy || backgroundBusy;
      if (submitBtn) submitBtn.disabled = disabled;
      if (avatarUploadBtn) avatarUploadBtn.disabled = disabled;
      if (avatarDeleteBtn) avatarDeleteBtn.disabled = disabled;
      if (avatarInput) avatarInput.disabled = disabled;
      if (bannerUploadBtn) bannerUploadBtn.disabled = disabled;
      if (bannerDeleteBtn) bannerDeleteBtn.disabled = disabled;
      if (bannerInput) bannerInput.disabled = disabled;
      if (backgroundUploadBtn) backgroundUploadBtn.disabled = disabled;
      if (backgroundDeleteBtn) backgroundDeleteBtn.disabled = disabled;
      if (backgroundInput) backgroundInput.disabled = disabled;
