    avatarUploadBtn?.addEventListener("click", () => {
      if (avatarBusy) return;
      avatarInput?.click();
    });

    avatarInput?.addEventListener("change", async () => {
      const file = avatarInput.files && avatarInput.files[0];
      if (!file) return;

      try {
        const fileType = String(file.type || "").toLowerCase();
        const fileExt = getAvatarFileExt(file);
        const isGif = fileType === "image/gif" || fileExt === "gif";
        const isSupportedStatic =
          /^image\/(png|jpeg|webp)$/.test(fileType) ||
          /^(png|jpg|jpeg|webp)$/.test(fileExt);

        if (!isGif && !isSupportedStatic) {
          throw new Error("Use a PNG, JPG, WEBP, or GIF image.");
        }

        const dataUrl = await readFileAsDataUrl(file);

        if (isGif) {
          avatarBusy = true;
          syncBusyState();
          setStatus("Uploading avatar...");

          try {
            await uploadAvatarData(dataUrl, {
              filename: file.name || "avatar.gif",
              mime: fileType || "image/gif",
            });
            setStatus("Avatar updated.");
          } finally {
            avatarBusy = false;
            syncBusyState();
          }
          return;
        }

        const image = await loadImageElement(dataUrl);

        openAvatarCropModal(file, image, async () => {
          if (!avatarCropState) return;

          avatarBusy = true;
          avatarCropState.busy = true;
          syncBusyState();
          avatarCropConfirmBtn.disabled = true;
          setStatus("Uploading avatar...");
