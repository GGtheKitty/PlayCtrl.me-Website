          try {
            const outputCanvas = document.createElement("canvas");
            outputCanvas.width = avatarCropState.config.outputWidth;
            outputCanvas.height = avatarCropState.config.outputHeight;

            const ctx = outputCanvas.getContext("2d");
            if (!ctx) {
              throw new Error("Could not prepare that crop.");
            }

            const cropRect = getAvatarCropSourceRect();
            if (!cropRect) {
              throw new Error("Could not prepare that crop.");
            }

            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = "high";
            ctx.drawImage(
              avatarCropState.image,
              cropRect.sx,
              cropRect.sy,
              cropRect.sourceWidth,
              cropRect.sourceHeight,
              0,
              0,
              outputCanvas.width,
              outputCanvas.height,
            );

            await uploadAvatarData(canvasToDataUrl(outputCanvas), {
              filename: "avatar-crop.png",
              mime: "image/png",
            });
            setStatus("Avatar updated.");
            closeAvatarCropModal(true);
          } catch (err) {
            const message = err && err.message ? err.message : "Could not update avatar.";
            setStatus(message);
            setAvatarCropStatus(message);
          } finally {
            avatarBusy = false;
            if (avatarCropState) avatarCropState.busy = false;
            syncBusyState();
