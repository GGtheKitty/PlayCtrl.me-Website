<script>
  (function () {
    const grid = document.getElementById("uGrid");
    if (!grid) return;

    function normPair(v) {
      return String(v || "").trim();
    }

    function normalizeStatus(status) {
      const value = String(status || "").trim().toLowerCase();
      if (value === "online" || value === "away") return value;
      return "offline";
    }

    function setDot(card, statusValue) {
      const status = normalizeStatus(statusValue);
      const dot = card.querySelector(".statusDot");
      if (!dot) return;

      card.dataset.status = status;
      card.dataset.online = status === "online" ? "1" : "0";
      dot.classList.remove("statusDot--online", "statusDot--away", "statusDot--offline");
      dot.classList.add("statusDot--" + status);
      dot.title = status === "online" ? "Online" : status === "away" ? "Away" : "Offline";
    }

    function resortCards() {
      const cards = Array.from(grid.querySelectorAll(".uCard[data-pair]"));
      const statusRank = { online: 0, away: 1, offline: 2 };

      cards.sort((a, b) => {
        const ar = statusRank[normalizeStatus(a.dataset.status)] ?? 9;
        const br = statusRank[normalizeStatus(b.dataset.status)] ?? 9;
        if (ar !== br) return ar - br;

        const at = Number(a.getAttribute("data-fav-ts") || a.getAttribute("data-favorited-at") || 0);
        const bt = Number(b.getAttribute("data-fav-ts") || b.getAttribute("data-favorited-at") || 0);
        if (at !== bt) return at - bt;

        return normPair(a.getAttribute("data-pair")).localeCompare(normPair(b.getAttribute("data-pair")));
      });

      const frag = document.createDocumentFragment();
      for (const c of cards) frag.appendChild(c);
      grid.appendChild(frag);
    }

    async function tick() {
      try {
        const res = await fetch("/api/presence/favorites", {
          headers: { "Accept": "application/json" },
          credentials: "include"
        });

        const data = await res.json().catch(() => null);
        if (!res.ok || !data || !data.ok || !data.map) return;

        const cards = Array.from(grid.querySelectorAll(".uCard[data-pair]"));
        let changed = false;

        for (const card of cards) {
          const code = normPair(card.getAttribute("data-pair"));

          const st = data.map[code];
          const status = normalizeStatus(st?.status || (st?.online ? "online" : "offline"));

          const prev = normalizeStatus(card.dataset.status);
          if (prev !== status) changed = true;

          setDot(card, status);

          card.style.display = "";
        }

        if (changed) resortCards();
      } catch (e) {

      }
    }


    Array.from(grid.querySelectorAll(".uCard[data-pair]")).forEach(card => {
      const initialStatus =
        card.getAttribute("data-status") ||
        (card.getAttribute("data-online") === "1" ? "online" : "offline");
      setDot(card, initialStatus);
    });

    resortCards();
    tick();
    setInterval(tick, 5000);
  })();
</script>
