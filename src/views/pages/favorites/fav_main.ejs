<!DOCTYPE html>
<html>

<head>
  <link rel="stylesheet" href="/css/discover.css">
</head>

<body>

  <div class="card" style="align-items:center;">
    <div class="cardHd">
      <h2>Favorites</h2>
      <p style="opacity:.75;margin-top:6px;">
        Users you have added to your favorites appear here.
      </p>
    </div>
    <div class="cardBd">
      <% if (favUsers && favUsers.length) { %>
      <div class="uGrid" id="uGrid">
        <% for (const u of favUsers) { %>
        <%- include("../../common/user_cards", {
            display: u.global_name || u.username || u.discord_id,
            handle: u.username || "",
            avatar: siteAvatarUrl(u, 128),
            banner: u.custom_banner_path
              ? `${siteBannerUrl(u, 1200)}${u.custom_banner_updated_at ? `&v=${encodeURIComponent(u.custom_banner_updated_at)}` : ""}`
              : "",
            code: u.code_plain,
            id: u.discord_id,
            favorited_at: u.favorited_at,
            status: u.status || (u.online ? "online" : "offline")
          }) %>
        <% } %>
      </div>
      <% } else { %>
      <div class="muted">No favorites yet. Go to Discover and add some.</div>
      <% } %>
    </div>
  </div>

  <%- include("fav_scripts", { user }) %>

</body>

</html>
