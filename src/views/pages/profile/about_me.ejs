<div class="card profileListsCard">
  <div class="cardHd"><%= LISTS.favorites.label %> / <%= LISTS.dislikes.label %></div>
  <div class="cardBd">
    <div class="profileListToolbar">
      <input
        class="profileListSearch"
        id="listSearch"
        type="text"
        placeholder="Search interests..."
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <div class="profileListHint">
      Left click cycles forward. Right click cycles backward.
    </div>

    <div class="profileListPillBox">
      <div class="profileListPillWrap" id="listBox">
        <% for (const it of catalog) { %>
          <% const favOn = selections.favorites && selections.favorites.has(it.key); %>
          <% const disOn = selections.dislikes && selections.dislikes.has(it.key); %>
          <% const state = favOn ? "favorite" : disOn ? "dislike" : "none"; %>
          <button
            class="profileListPill"
            type="button"
            data-key="<%= it.key %>"
            data-label="<%= it.label.toLowerCase() %>"
            data-fav="<%= favOn ? "1" : "0" %>"
            data-dis="<%= disOn ? "1" : "0" %>"
            data-state="<%= state %>"
            aria-pressed="<%= state === "none" ? "false" : "true" %>"
          >
            <span><%= it.label %></span>
          </button>
        <% } %>
      </div>

      <div class="profileListEmpty muted" id="listEmpty" hidden>
        Nothing matches your search.
      </div>
    </div>
  </div>
</div>
