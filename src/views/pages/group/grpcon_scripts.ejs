  function sanitizeWriteForMeMessage(value, maxLength = 4000) {
    const limit = Math.max(0, Number(maxLength) || 4000);
    return String(value || "")
      .replace(/[^\x20-\x7E]/g, "")
      .slice(0, limit);
  }

  function getWriteForMeTextarea(target) {
    if (!target || typeof target.matches !== "function") return null;
    if (!target.matches('textarea[data-write-for-me-message="1"]')) return null;
    return target;
  }

  function sanitizeWriteForMeTextarea(textarea) {
    if (!textarea) return "";

    const maxLength = Number(textarea.getAttribute("maxlength") || 4000) || 4000;
    const sanitized = sanitizeWriteForMeMessage(textarea.value, maxLength);

    if (sanitized !== textarea.value) {
      const caret = typeof textarea.selectionStart === "number"
        ? Math.min(textarea.selectionStart, sanitized.length)
        : sanitized.length;
      textarea.value = sanitized;
      try {
        textarea.setSelectionRange(caret, caret);
      } catch {}
    }

    return sanitized;
  }

  function insertWriteForMeText(textarea, text) {
    if (!textarea) return;

    const maxLength = Number(textarea.getAttribute("maxlength") || 4000) || 4000;
    const start = typeof textarea.selectionStart === "number" ? textarea.selectionStart : textarea.value.length;
    const end = typeof textarea.selectionEnd === "number" ? textarea.selectionEnd : textarea.value.length;
    const remaining = Math.max(0, maxLength - (textarea.value.length - (end - start)));
    const sanitized = sanitizeWriteForMeMessage(text, remaining);

    if (!sanitized) return;

    if (typeof textarea.setRangeText === "function") {
      textarea.setRangeText(sanitized, start, end, "end");
      return;
    }

    const nextValue = textarea.value.slice(0, start) + sanitized + textarea.value.slice(end);
    textarea.value = nextValue.slice(0, maxLength);
  }

  function validateWriteForMeForm(form) {
    if (!form || form.dataset.cmd !== "write_for_me") return true;

    const textarea = form.querySelector('textarea[data-write-for-me-message="1"]');
    if (!textarea) return true;

    const original = String(textarea.value || "");
    const sanitized = sanitizeWriteForMeTextarea(textarea);
    if (sanitized.trim()) return true;

    addLine(
      original.trim()
        ? "Message must be a single line with standard keyboard characters only."
        : "Missing message",
      "error"
    );
    textarea.focus();
    return false;
  }

  function validateSubliminalMessageForm(form) {
    if (!form || form.dataset.cmd !== "subliminal_message") return true;

    const textareas = Array.from(
      form.querySelectorAll('textarea[data-subliminal-message="1"]'),
    );
    if (!textareas.length) return true;

    let hasMessage = false;
    for (const textarea of textareas) {
      const value = String(textarea.value || "").trim();
      textarea.value = value;
      if (value) hasMessage = true;
    }

    if (hasMessage) return true;

    addLine("Add at least one message.", "error");
    textareas[0]?.focus();
    return false;
  }

