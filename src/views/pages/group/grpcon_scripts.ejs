  const RESP_ENDPOINT = "/api/group/" + encodeURIComponent(groupKey) + "/responses";

  let baselineSeen = false;
  let lastSeenId = null;
  let lastSeenCreatedAt = 0;

  let pendingScreenshot = null;
  let pendingWebcam = null;

  function normalizeResponseItem(it) {
    const commandId =
      it?.commandId ??
      it?.command_id ??
      it?.id ??
      it?.cmdId ??
      it?.command?.commandId ??
      null;

    const createdAt =
      Number(it?.created_at ?? it?.createdAt ?? it?.ts ?? it?.time ?? 0) || 0;

    const details = it?.details ?? it?.payload ?? it?.data ?? null;

    const kind =
      it?.kind ??
      it?.type ??
      it?.response_type ??
      it?.responseType ??
      details?.kind ??
      details?.type ??
      null;

    const mime =
      it?.mime ??
      it?.content_type ??
      it?.contentType ??
      details?.mime ??
      details?.content_type ??
      null;

    const url =
      it?.url ??
      it?.imageUrl ??
      it?.image_url ??
      details?.url ??
      details?.imageUrl ??
      null;

    const webpB64 =
      details?.webp_b64 ??
      details?.webpB64 ??
      it?.webp_b64 ??
      it?.webpB64 ??
      null;

    return { raw: it, commandId, createdAt, details, kind, mime, url, webpB64 };
  }

  function markSeen(n) {
    if (!n) return;
    if (n.commandId) lastSeenId = String(n.commandId);
    if (n.createdAt) lastSeenCreatedAt = Math.max(lastSeenCreatedAt, Number(n.createdAt) || 0);
  }

  function isNewerThanBaseline(n) {
    if (n.commandId && lastSeenId && String(n.commandId) !== String(lastSeenId)) return true;
    if (n.createdAt && n.createdAt > lastSeenCreatedAt) return true;
    return false;
  }

  function isWebpImageResponse(n, wantKind) {
    const k = (n.kind ? String(n.kind).toLowerCase() : "");
    const m = (n.mime ? String(n.mime).toLowerCase() : "");
    const kindOk = wantKind ? k.includes(String(wantKind).toLowerCase()) : false;
    return kindOk || m.includes("image/webp") || !!n.webpB64;
  }

  function addImagePreviewUrl(url, label) {
