    avatarUploadBtn?.addEventListener("click", () => avatarInput?.click());
    bannerUploadBtn?.addEventListener("click", () => bannerInput?.click());
    avatarInput?.addEventListener("change", () => uploadAsset("avatar", avatarInput.files && avatarInput.files[0]));
    bannerInput?.addEventListener("change", () => uploadAsset("banner", bannerInput.files && bannerInput.files[0]));
    avatarDeleteBtn?.addEventListener("click", () => {
