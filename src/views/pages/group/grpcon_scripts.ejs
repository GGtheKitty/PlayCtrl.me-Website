    respBox.prepend(wrap);
  }

  async function fetchResponses() {
    const res = await fetch(RESP_ENDPOINT, {
      headers: { "Accept": "application/json" },
      credentials: "include"
    });

    const ct = res.headers.get("content-type") || "";
    let data = null;
    if (ct.includes("application/json")) data = await res.json().catch(() => null);

    if (!res.ok) throw new Error("responses_http_" + res.status);
    if (!data) throw new Error("responses_not_json");

    const items = Array.isArray(data.items) ? data.items : (Array.isArray(data.responses) ? data.responses : []);
    return items;
  }

  let pollTimer = null;
  function startPoll(intervalMs = 1000) {
    if (pollTimer) clearInterval(pollTimer);
    pollTimer = setInterval(async () => {
      try {
        const items = await fetchResponses();
        if (!baselineSeen) {
          if (items.length) markSeen(normalizeResponseItem(items[0]));
          baselineSeen = true;
          return;
        }

        const normalized = items.map(normalizeResponseItem);

        if (pendingScreenshot) {
          if (Date.now() > pendingScreenshot.timeoutAt) {
            addLine("Timed out waiting for screenshot response.", "error");
            pendingScreenshot = null;
          } else {
            const candidates = normalized.filter(n => isWebpImageResponse(n, "screenshot"));
            let match = null;
            if (pendingScreenshot.commandIdGuess) {
              match = candidates.find(c => String(c.commandId) === String(pendingScreenshot.commandIdGuess)) || null;
            }
            if (!match) match = candidates.find(c => isNewerThanBaseline(c)) || null;

            if (match && match.url) {
              const bust = String(match.url) + (String(match.url).includes("?") ? "&" : "?") +
                "t=" + encodeURIComponent(String(match.createdAt || Date.now()));
              addImagePreviewUrl(bust, "Screenshot");
              markSeen(match);
              pendingScreenshot = null;
              return;
            }
          }
        }

        if (pendingWebcam) {
          if (Date.now() > pendingWebcam.timeoutAt) {
            addLine("Timed out waiting for webcam capture response.", "error");
            pendingWebcam = null;
          } else {
            const candidates = normalized.filter(n => isWebpImageResponse(n, "webcam"));
            let match = null;
            if (pendingWebcam.commandIdGuess) {
              match = candidates.find(c => String(c.commandId) === String(pendingWebcam.commandIdGuess)) || null;
            }
            if (!match) match = candidates.find(c => isNewerThanBaseline(c)) || null;

            if (match && match.url) {
              const bust = String(match.url) + (String(match.url).includes("?") ? "&" : "?") +
                "t=" + encodeURIComponent(String(match.createdAt || Date.now()));
              addImagePreviewUrl(bust, "Webcam");
              markSeen(match);
              pendingWebcam = null;
              return;
            }
          }
        }

        const newest = normalized[0];
        if (newest && isNewerThanBaseline(newest)) {
          addLine("New response: kind=" + (newest.kind || "?"), "info");
          markSeen(newest);
        }
      } catch (e) {

      }
    }, intervalMs);
  }

  startPoll(1000);
  
  async function postForm(form) {
    const action = form.getAttribute("action");
    const cmd = form.dataset.cmd || "command";
    if (!action) return;

    if (isCoolingDown()) {
      startCooldown();
      addLine("Please wait for cooldown.", "cooldown");
      return;
    }

    const params = new URLSearchParams(new FormData(form));
    clearFormFields(form);

    startCooldown();
    addLine("Sending " + cmd + "...", "send");

    let res, data = null, bodyText = null;
    try {
      res = await fetch(action, {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8"
        },
        body: params.toString(),
        credentials: "include"
      });
    } catch (e) {
      addLine("Network error: " + (e?.message || String(e)), "error");
      return;
    }

    const ct = (res.headers.get("content-type") || "");
    try {
      if (ct.includes("application/json")) data = await res.json();
      else bodyText = await res.text();
    } catch {
      bodyText = bodyText || "(failed to parse response)";
    }

    if (res.status === 429 && data && (data.code === "WEB_COOLDOWN" || data.code === "COOLDOWN")) {
      const retryMs = Number(data.retry_after_ms || data.retryAfterMs || COOLDOWN_MS);
      nextAllowedAt = Date.now() + Math.max(500, retryMs);
      startCooldown();
      addLine("Cooldown: wait " + Math.ceil(retryMs / 1000) + "s", "cooldown");
      return;
    }

    if (!res.ok) {
      if (data && data.message) addLine(data.message, "error");
      else addLine("HTTP " + res.status + " " + res.statusText + " — " + (bodyText || ""), "error");
      return;
    }

    addLine((data && (data.message || ("OK (sent=" + (data.sent ?? "?") + ")"))) || bodyText || "OK", "ok");
    hideCmdModal();

    if (cmd === "screenshot") {
      const commandIdGuess = data?.commandId || data?.id || data?.command_id || null;
      pendingScreenshot = { timeoutAt: Date.now() + 45000, commandIdGuess };
      addLine("Waiting for screenshot response..." + (commandIdGuess ? (" (commandId=" + commandIdGuess + ")") : ""), "info");
    }

    if (cmd === "webcam_capture") {
      const commandIdGuess = data?.commandId || data?.id || data?.command_id || null;
      pendingWebcam = { timeoutAt: Date.now() + 45000, commandIdGuess };
      addLine("Waiting for webcam capture response..." + (commandIdGuess ? (" (commandId=" + commandIdGuess + ")") : ""), "info");
    }
  }

  async function postInstant(btn, action, cmd) {
    if (!action) return;

    if (isCoolingDown()) {
      startCooldown();
      addLine("Please wait for cooldown.", "cooldown");
      return;
    }

    startCooldown();
    if (btn) {
      btn.disabled = true;
      btn.style.opacity = "0.65";
    }
    addLine("Sending " + cmd + "...", "send");

    let res, data = null, bodyText = null;
    try {
      res = await fetch(action, {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8"
        },
        body: "",
        credentials: "include"
      });
    } catch (e) {
      addLine("Network error: " + (e?.message || String(e)), "error");
      if (btn) { btn.disabled = false; btn.style.opacity = ""; }
      return;
    }

    const ct = (res.headers.get("content-type") || "");
    try {
      if (ct.includes("application/json")) data = await res.json();
      else bodyText = await res.text();
    } catch {
      bodyText = bodyText || "(failed to parse response)";
    } finally {
      if (btn) { btn.disabled = false; btn.style.opacity = ""; }
    }

    if (res.status === 429 && data && (data.code === "WEB_COOLDOWN" || data.code === "COOLDOWN")) {
      const retryMs = Number(data.retry_after_ms || data.retryAfterMs || COOLDOWN_MS);
      nextAllowedAt = Date.now() + Math.max(500, retryMs);
      startCooldown();
      addLine("Cooldown: wait " + Math.ceil(retryMs / 1000) + "s", "cooldown");
      return;
    }

    if (!res.ok) {
      if (data && data.message) addLine(data.message, "error");
      else addLine("HTTP " + res.status + " " + res.statusText + " — " + (bodyText || ""), "error");
      return;
    }

    addLine((data && (data.message || "OK")) || bodyText || "OK", "ok");

    if (cmd === "screenshot") {
      const commandIdGuess = data?.commandId || data?.id || data?.command_id || null;
      pendingScreenshot = { timeoutAt: Date.now() + 45000, commandIdGuess };
      addLine("Waiting for screenshot response..." + (commandIdGuess ? (" (commandId=" + commandIdGuess + ")") : ""), "info");
    }

    if (cmd === "webcam_capture") {
      const commandIdGuess = data?.commandId || data?.id || data?.command_id || null;
      pendingWebcam = { timeoutAt: Date.now() + 45000, commandIdGuess };
      addLine("Waiting for webcam capture response..." + (commandIdGuess ? (" (commandId=" + commandIdGuess + ")") : ""), "info");
    }
  }

  document.addEventListener("submit", (e) => {
    const form = e.target;
    if (!form || !form.classList || !form.classList.contains("cmdForm")) return;
    e.preventDefault();
    if (!validateWriteForMeForm(form)) return;
    if (!validateSubliminalMessageForm(form)) return;
    postForm(form);
  });

  document.addEventListener("submit", (e) => {
    const form = e.target;
    if (!form || form.id !== "groupCommandSettingsForm") return;
    e.preventDefault();
    submitGroupCommandSettings(form);
  });

  document.addEventListener("submit", async (e) => {
    const form = e.target;
    if (!form || form.id !== "groupMessageReportForm") return;
    e.preventDefault();

    const messageId = String(form.querySelector('input[name="messageId"]')?.value || "").trim();
    const submitBtn = form.querySelector('button[type="submit"]');
    const status = form.querySelector("[data-group-message-report-status]");
    if (!messageId || !form.reportValidity()) return;

    if (submitBtn) submitBtn.disabled = true;
    if (status) status.textContent = "Sending report...";
    try {
      const res = await fetch(
        "/api/group/" + encodeURIComponent(groupKey) + "/board/" + encodeURIComponent(messageId) + "/report",
        {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "X-Requested-With": "XMLHttpRequest",
            "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
          },
          body: new URLSearchParams(new FormData(form)).toString(),
          credentials: "include",
        },
      );
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) {
        throw new Error(data?.message || "Could not report message.");
      }
      reportedGroupMessageIds.add(messageId);
      if (status) status.textContent = data.message || "Message reported.";
      const reportButton = Array.from(
        groupBoardList?.querySelectorAll('[data-group-message-action="report"]') || [],
      ).find((button) => String(button.dataset.messageId || "") === messageId);
      if (reportButton) {
        reportButton.disabled = true;
        reportButton.title = "Message reported";
        reportButton.setAttribute("aria-label", "Message reported");
      }
      window.setTimeout(hideCmdModal, 700);
    } catch (err) {
      if (status) status.textContent = err?.message || "Could not report message.";
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  document.addEventListener("submit", async (e) => {
    const form = e.target;
    if (!form || form.id !== "groupReportForm") return;
    e.preventDefault();

    const submitBtn = form.querySelector('button[type="submit"]');
    const status = form.querySelector("[data-group-report-status]");
    if (!form.reportValidity()) return;

    if (submitBtn) submitBtn.disabled = true;
    if (status) status.textContent = "Sending report...";
    try {
      const res = await fetch(
        "/api/group/" + encodeURIComponent(groupKey) + "/report",
        {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "X-Requested-With": "XMLHttpRequest",
            "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
          },
          body: new URLSearchParams(new FormData(form)).toString(),
          credentials: "include",
        },
      );
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) {
        throw new Error(data?.message || "Could not report group.");
      }
      if (status) status.textContent = data.message || "Report sent.";
      if (groupReportBtn) {
        groupReportBtn.disabled = true;
        groupReportBtn.textContent = "Reported";
      }
      window.setTimeout(hideCmdModal, 700);
    } catch (err) {
      if (status) status.textContent = err?.message || "Could not report group.";
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  groupBoardForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!canPostGroupBoard || !groupBoardInput) return;

    const body = String(groupBoardInput.value || "").trim();
    if (!body) return;

    groupBoardInput.value = "";
    try {
      await postGroupBoardMessage(body);
    } catch (err) {
      setGroupBoardStatus(err?.message || "Failed to post.");
      groupBoardInput.value = body;
    }
  });

  groupBoardList?.addEventListener("click", (e) => {
    const button = e.target?.closest?.("[data-group-message-action]");
    if (!button) return;
    e.preventDefault();
    const messageId = String(button.dataset.messageId || "").trim();
    if (!messageId) return;

    if (button.dataset.groupMessageAction === "report") {
      openGroupMessageReport(messageId);
    } else if (button.dataset.groupMessageAction === "delete") {
      deleteGroupMessage(messageId, button);
    }
  });

  document.addEventListener("click", async (e) => {
    const btn = e.target.closest("[data-instant-cmd]");
    if (!btn) return;

    e.preventDefault();

    const cmd = String(btn.dataset.instantCmd || "");
    const action = String(btn.dataset.action || "");
    const isHeavy = btn.dataset.heavy === "1";

    if (!cmd || !action) return;

    if (isHeavy && isHeavyCoolingDown()) {
      addLine("Please wait for heavy command cooldown.", "cooldown");
      return;
    }

    if (isHeavy) startHeavyCooldown();
    await postInstant(btn, action, cmd);
  });

  (() => {
    const form = document.getElementById("groupMembershipForm");
    const btn = document.getElementById("groupMembershipBtn");
    const memberCountEl = document.getElementById("memberCount");

    if (!form || !btn) return;

    let busy = false;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (busy) return;

      busy = true;
      const oldText = btn.textContent;
      btn.disabled = true;

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: {
            "X-Requested-With": "XMLHttpRequest",
            "Accept": "application/json"
          },
          credentials: "same-origin"
        });

        if (!res.ok) {
          throw new Error("Request failed");
        }

        let data = null;
        const contentType = res.headers.get("content-type") || "";

        if (contentType.includes("application/json")) {
          data = await res.json();
        }

        const wasMember = btn.dataset.isMember === "1";
        const nowMember =
          data && typeof data.isMember !== "undefined"
            ? !!data.isMember
            : !wasMember;
        canPostGroupBoard = nowMember;
        syncGroupBoardPostState();
        refreshGroupBoard({ forceRender: true });

        btn.dataset.isMember = nowMember ? "1" : "0";
        btn.textContent = nowMember ? "Leave Group" : "Join Group";
        btn.classList.toggle("isFav", nowMember);

        form.action = `/api/group/<%= encodeURIComponent(groupKey) %>/${nowMember ? "leave" : "join"}`;

        if (memberCountEl) {
          if (data && typeof data.memberCount !== "undefined") {
            memberCountEl.textContent = data.memberCount;
          } else {
            const current = parseInt(memberCountEl.textContent || "0", 10) || 0;
            memberCountEl.textContent = Math.max(0, current + (nowMember ? 1 : -1));
          }
        }
      } catch (err) {
        btn.textContent = oldText;
        alert("Could not update group membership.");
      } finally {
        btn.disabled = false;
        busy = false;
      }
    });
  })();

  if (isCommunityGroup && isOwner) {
    applyCommunityGroupCommandPrefs(communityGroupCommandPrefs);
  }

  syncGroupBoardPostState();
  renderGroupBoard({ scrollToBottom: true });
  refreshGroupBoard({ forceRender: true });
  window.setInterval(refreshGroupBoard, 3000);
  window.setInterval(() => renderGroupBoard(), 15000);
</script>
<% } %>
