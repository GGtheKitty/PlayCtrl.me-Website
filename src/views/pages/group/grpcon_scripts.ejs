  const COOLDOWN_APPLIES = <%- inlineScriptJson(!!cooldownApplies) %>;
  const COOLDOWN_MS = 3000;

  const overlay = document.getElementById("cooldownOverlay");
  const overlaySeconds = document.getElementById("cooldownSeconds");

  let nextAllowedAt = 0;
  let countdownTimer = null;

  function showOverlay(msLeft) {
    if (!overlay) return;
    const s = Math.max(0, Math.ceil(msLeft / 1000));
    if (overlaySeconds) overlaySeconds.textContent = String(s);
    overlay.setAttribute("data-show", "true");
    overlay.setAttribute("aria-hidden", "false");
  }

  function hideOverlay() {
    if (!overlay) return;
