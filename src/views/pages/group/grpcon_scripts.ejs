<% if (user) { %>
<script>
  const respBox = document.getElementById("respBox");
  const clearBtn = document.getElementById("clearResp");

  const groupKey = <%- inlineScriptJson(groupKey) %>;
  const isCommunityGroup = <%- inlineScriptJson(!!isCommunityGroup) %>;
  const isOwner = <%- inlineScriptJson(!!isOwner) %>;
  const viewerUserId = <%- inlineScriptJson(String(user?.discord_id || "")) %>;
  const viewerIsGroupChatAdmin = <%- inlineScriptJson(!!viewerIsGroupChatAdmin) %>;
  const communityGroupCommandOptions = <%- inlineScriptJson(communityGroupCommandOptions || []) %>;
  let communityGroupCommandPrefs = <%- inlineScriptJson(communityGroupCommandPrefs || {}) %>;
  let groupBoardMessages = <%- inlineScriptJson(groupBoardMsgs || []) %>;
  let canPostGroupBoard = <%- inlineScriptJson(!!canPostGroupBoard) %>;
  let activeGroupName = <%- inlineScriptJson(groupLabel || "") %>;
  let activeGroupAbout = <%- inlineScriptJson(communityGroupDescription || "") %>;
  let activeGroupAvatarUrl = <%- inlineScriptJson(groupIconUrl || "/default-avatar.svg") %>;
  let activeGroupBannerUrl = <%- inlineScriptJson(groupBannerUrl || "") %>;
  let activeGroupAvatarVersion = <%- inlineScriptJson(Number(groupAvatarVersion || 0) || 0) %>;
  let activeGroupBannerVersion = <%- inlineScriptJson(Number(groupBannerVersion || 0) || 0) %>;
  let activeGroupHasCustomAvatar = <%- inlineScriptJson(!!groupHasCustomAvatar) %>;
  let activeGroupHasCustomBanner = <%- inlineScriptJson(!!groupHasCustomBanner) %>;
  const reportedGroupMessageIds = new Set();

  function addLine(text, kind) {
    if (!respBox) return;

    const row = document.createElement("div");
    row.className = "respRow";

    const time = document.createElement("div");
    time.className = "respBubble respTime";
    time.textContent = new Date().toLocaleTimeString([], {
      hour: "numeric",
      minute: "2-digit"
    });

    const msg = document.createElement("div");
    msg.className = "respBubble respMsg";
    msg.textContent = text;

    row.appendChild(time);
    row.appendChild(msg);

    respBox.prepend(row);
  }

  function clearFormFields(form) {
    form.querySelectorAll("input[type=text], input[type=url], input:not([type]), textarea").forEach(el => {
      el.value = "";
    });
  }

  function setGroupBoardStatus(text) {
    if (groupBoardStatus) groupBoardStatus.textContent = text || "";
  }

  function groupBoardRelTime(ms) {
    const seconds = Math.max(0, Math.floor((Date.now() - Number(ms || 0)) / 1000));
    if (seconds < 60) return seconds + "s ago";
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return minutes + "m ago";
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return hours + "h ago";
    const days = Math.floor(hours / 24);
    return days + " day" + (days === 1 ? "" : "s") + " ago";
  }

  function scrollGroupBoardToBottom() {
    if (!groupBoardList) return;
    requestAnimationFrame(() => {
      groupBoardList.scrollTop = groupBoardList.scrollHeight;
    });
  }

  function syncGroupBoardPostState() {
    if (groupBoardForm) groupBoardForm.hidden = !canPostGroupBoard;
    if (groupBoardReadonly) groupBoardReadonly.hidden = !!canPostGroupBoard;
  }

  function renderGroupBoard({ scrollToBottom = false } = {}) {
    if (!groupBoardList) return;

    groupBoardList.innerHTML = "";
    if (!groupBoardMessages.length) {
      const empty = document.createElement("div");
      empty.className = "boardEmpty";
      empty.textContent = "No group messages yet.";
      groupBoardList.appendChild(empty);
      return;
    }

    const ordered = [...groupBoardMessages].sort((a, b) => {
      const createdDiff = Number(a.created_at || 0) - Number(b.created_at || 0);
      if (createdDiff) return createdDiff;
      return Number(a.id || 0) - Number(b.id || 0);
    });

    for (const msg of ordered) {
      const row = document.createElement("div");
      row.className = "boardRow";

      const avatar = document.createElement("img");
      avatar.className = "boardAvatar";
      avatar.src = String(msg.author_avatar_url || "/img/default-avatar.png");
      avatar.alt = "";

      const body = document.createElement("div");
      body.className = "boardBody";

      const bubble = document.createElement("div");
      bubble.className = "boardBubble";
      bubble.textContent = String(msg.body || "");

      const meta = document.createElement("div");
      meta.className = "boardMeta";
      const author = String(msg.author_display_name || "Member").trim() || "Member";
      meta.textContent = author + " - " + groupBoardRelTime(msg.created_at);

      body.appendChild(bubble);
      body.appendChild(meta);
      row.appendChild(avatar);
      row.appendChild(body);

      const messageId = String(msg.id || "").trim();
      const canReport =
        messageId && String(msg.author_user_id || "").trim() !== viewerUserId;
      if (canReport || viewerIsGroupChatAdmin) {
        const actions = document.createElement("div");
        actions.className = "groupMessageActions";
        actions.setAttribute("aria-label", "Message actions");

        if (canReport) {
          const reportBtn = document.createElement("button");
          const alreadyReported = reportedGroupMessageIds.has(messageId);
          reportBtn.type = "button";
          reportBtn.className = "groupMessageActionBtn";
          reportBtn.dataset.groupMessageAction = "report";
          reportBtn.dataset.messageId = messageId;
          reportBtn.disabled = alreadyReported;
          reportBtn.title = alreadyReported ? "Message reported" : "Report message";
          reportBtn.setAttribute("aria-label", reportBtn.title);
          reportBtn.innerHTML = '<img src="/icons/group-chat-report.svg" alt="" aria-hidden="true">';
          actions.appendChild(reportBtn);
        }

        if (viewerIsGroupChatAdmin) {
          const deleteBtn = document.createElement("button");
          deleteBtn.type = "button";
          deleteBtn.className = "groupMessageActionBtn groupMessageActionBtn--delete";
          deleteBtn.dataset.groupMessageAction = "delete";
          deleteBtn.dataset.messageId = messageId;
          deleteBtn.title = "Delete message";
          deleteBtn.setAttribute("aria-label", "Delete message");
          deleteBtn.innerHTML = '<img src="/icons/group-chat-delete.svg" alt="" aria-hidden="true">';
          actions.appendChild(deleteBtn);
        }

        row.appendChild(actions);
      }
      groupBoardList.appendChild(row);
    }

    if (scrollToBottom) scrollGroupBoardToBottom();
  }

  async function refreshGroupBoard({ forceRender = false } = {}) {
    if (!groupBoardList) return;

    try {
      const res = await fetch("/api/group/" + encodeURIComponent(groupKey) + "/board", {
        headers: { "Accept": "application/json" },
        credentials: "include",
      });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data || !data.ok) return;

      const nextMessages = Array.isArray(data.messages) ? data.messages : [];
      const changed =
        nextMessages.length !== groupBoardMessages.length ||
        Number(nextMessages[0]?.id || 0) !== Number(groupBoardMessages[0]?.id || 0);

      canPostGroupBoard = !!data.canPost;
      syncGroupBoardPostState();

      if (!changed && !forceRender) return;
      groupBoardMessages = nextMessages;
      renderGroupBoard({ scrollToBottom: true });
    } catch {}
  }

  async function postGroupBoardMessage(body) {
    setGroupBoardStatus("Posting...");
    const res = await fetch("/api/group/" + encodeURIComponent(groupKey) + "/board", {
      method: "POST",
      headers: {
        "Accept": "application/json",
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
      },
      body: new URLSearchParams({ body }).toString(),
      credentials: "include",
    });

    const data = await res.json().catch(() => null);
    if (!res.ok || !data || !data.ok) {
      throw new Error(data?.message || data?.error || "Could not post.");
    }

    groupBoardMessages = Array.isArray(data.messages) ? data.messages : groupBoardMessages;
    renderGroupBoard({ scrollToBottom: true });
    setGroupBoardStatus("Posted.");
    window.setTimeout(() => setGroupBoardStatus(""), 900);
  }

  function openGroupMessageReport(messageId) {
    const message = groupBoardMessages.find(
      (item) => String(item?.id || "") === String(messageId || ""),
    );
    if (!message) {
      setGroupBoardStatus("Message not found.");
      return;
    }

    showCmdModal("Report Group Message", "tpl_group_message_report");
    const form = cmdModalBody?.querySelector("#groupMessageReportForm");
    if (!form) return;
    form.querySelector('input[name="messageId"]').value = String(message.id || "");
    const preview = form.querySelector("[data-group-message-report-preview]");
    if (preview) {
      const author = String(message.author_display_name || "Member");
      preview.textContent = author + ": “" + String(message.body || "") + "”";
    }
  }

  async function deleteGroupMessage(messageId, button) {
    const message = groupBoardMessages.find(
      (item) => String(item?.id || "") === String(messageId || ""),
    );
    if (!message || !window.confirm("Delete this group chat message?")) return;

    if (button) button.disabled = true;
    try {
      const res = await fetch(
        "/api/group/" + encodeURIComponent(groupKey) + "/board/" + encodeURIComponent(messageId),
        {
          method: "DELETE",
          headers: {
            "Accept": "application/json",
            "X-Requested-With": "XMLHttpRequest",
          },
          credentials: "include",
        },
      );
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) {
        throw new Error(data?.message || "Could not delete message.");
      }
      groupBoardMessages = Array.isArray(data.messages) ? data.messages : [];
      renderGroupBoard();
      setGroupBoardStatus("Message deleted.");
      window.setTimeout(() => setGroupBoardStatus(""), 1200);
    } catch (err) {
      setGroupBoardStatus(err?.message || "Could not delete message.");
      if (button) button.disabled = false;
    }
  }

  const cmdModal = document.getElementById("cmdModal");
  const cmdModalTitle = document.getElementById("cmdModalTitle");
  const cmdModalBody = document.getElementById("cmdModalBody");
  const cmdList = document.getElementById("cmdList");
  const groupCommandsEmpty = document.getElementById("groupCommandsEmpty");
  const groupCommandSettingsBtn = document.getElementById("groupCommandSettingsBtn");
  const groupReportBtn = document.getElementById("groupReportBtn");
  const groupBoardList = document.getElementById("groupBoardList");
  const groupBoardForm = document.getElementById("groupBoardForm");
  const groupBoardInput = document.getElementById("groupBoardInput");
  const groupBoardStatus = document.getElementById("groupBoardStatus");
  const groupBoardReadonly = document.getElementById("groupBoardReadonly");
  const groupAvatarImg = document.getElementById("groupAvatarImg");
  const groupBannerImage = document.getElementById("groupBannerImage");
  const groupDisplayNameEl = document.querySelector(".controlProfileDisplayName");
  const groupAboutTextEl = document.getElementById("groupAboutText");
  const groupAboutCard = document.getElementById("groupAboutCard");

  // Keep the modal outside the isolated group control-page stacking context so
  // it covers the sticky topbar, matching individual control links.
  function hoistGroupOverlayToBody(node) {
    if (!node || !document.body || node.parentElement === document.body) return;
    node.style.setProperty("--control-accent-rgb", "var(--ctl-accent-rgb, 167, 139, 250)");
    node.style.setProperty("--control-accent-deep-rgb", "var(--ctl-accent-deep-rgb, 139, 92, 246)");
    node.style.setProperty("--control-accent-glow-rgb", "var(--ctl-accent-glow-rgb, 139, 92, 246)");
    node.style.setProperty("--control-surface-rgb", "var(--ctl-surface-rgb, 20, 20, 28)");
    node.style.setProperty("--control-surface-2-rgb", "var(--ctl-surface-2-rgb, 14, 14, 24)");
    node.style.setProperty("--control-panel-rgb", "var(--ctl-panel-rgb, 18, 18, 30)");
    node.style.setProperty("--control-panel-2-rgb", "var(--ctl-panel-2-rgb, 12, 12, 22)");
    node.style.setProperty("--control-accent-strong", "rgb(var(--control-accent-rgb))");
    document.body.appendChild(node);
  }

  hoistGroupOverlayToBody(cmdModal);

  <%- include("../../common/upload_modal_client") %>

  (() => {
    const notificationBadgeSourceKey = "notifications";

    async function refreshNotificationBadge() {
      try {
        const res = await fetch("/notifications/summary", {
          headers: {
            "Accept": "application/json",
            "X-Requested-With": "XMLHttpRequest"
          },
          credentials: "include"
        });

        const data = await res.json().catch(() => null);
        if (!res.ok || !data || !data.ok) return;

        window.PlayCtrlTabBadge?.setSourceUnread(
          notificationBadgeSourceKey,
          Number(data.unreadCount || 0) > 0
        );
      } catch {}
    }

    refreshNotificationBadge();
    window.setInterval(refreshNotificationBadge, 15000);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") {
        refreshNotificationBadge();
      }
    });
    window.addEventListener("pagehide", () => {
      window.PlayCtrlTabBadge?.clearSource(notificationBadgeSourceKey);
    });
  })();

  function hideCmdModal() {
    if (!cmdModal || !cmdModalBody) return;
    if (window.stopUploadAudioPreview) window.stopUploadAudioPreview();
    cmdModalBody.innerHTML = "";
    cmdModal.style.display = "none";
    cmdModal.setAttribute("aria-hidden", "true");
  }

  function normalizeCommunityGroupPrefs(nextPrefs) {
    const normalized = {};
    for (const option of communityGroupCommandOptions) {
      const field = String(option?.field || "").trim();
      if (!field) continue;
      normalized[field] = !!nextPrefs?.[field];
    }
    return normalized;
  }

  function syncGroupCommandSettingsTemplate() {
    const template = document.getElementById("tpl_group_command_settings");
    const content = template?.content;
    if (!content) return;

    for (const option of communityGroupCommandOptions) {
      const field = String(option?.field || "").trim();
      if (!field) continue;
      const input = content.querySelector(`input[name="${field}"]`);
      if (!input) continue;
      input.checked = !!communityGroupCommandPrefs[field];
    }
  }

  function applyCommunityGroupCommandPrefs(nextPrefs) {
    if (!isCommunityGroup) return;

    communityGroupCommandPrefs = normalizeCommunityGroupPrefs({
      ...communityGroupCommandPrefs,
      ...nextPrefs,
    });

    const optionsByKey = new Map(
      communityGroupCommandOptions.map((option) => [String(option?.key || "").trim(), option]),
    );

    document.querySelectorAll(".cmdBtn[data-cmd]").forEach((btn) => {
      const option = optionsByKey.get(String(btn.dataset.cmd || "").trim());
      if (!option?.field) return;
      btn.hidden = !communityGroupCommandPrefs[option.field];
    });

    const hasEnabledCommands = communityGroupCommandOptions.some(
      (option) => !!communityGroupCommandPrefs[option.field],
    );

    if (cmdList) {
      cmdList.hidden = !hasEnabledCommands;
    }
    if (groupCommandsEmpty) {
      groupCommandsEmpty.hidden = hasEnabledCommands;
    }

    syncGroupCommandSettingsTemplate();
  }

  function setGroupEditStatus(form, text, type) {
    const status = form?.querySelector("#groupEditStatus");
    if (!status) return;
    status.textContent = text || "";
    status.dataset.type = type || "";
  }

  function setGroupEditBusy(form, busy) {
    form?.querySelectorAll("button, input, textarea").forEach((el) => {
      el.disabled = !!busy;
    });
  }

  function fileToDataUrl(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ""));
      reader.onerror = () => reject(reader.error || new Error("Could not read file."));
      reader.readAsDataURL(file);
    });
  }

  function appendVersion(url, version) {
    const value = String(url || "").trim();
    if (!value) return "";
    const sep = value.includes("?") ? "&" : "?";
    return value + sep + "v=" + encodeURIComponent(String(version || Date.now()));
  }

  function setBackgroundImage(el, url) {
    if (!el) return;
    el.hidden = !url;
    el.style.backgroundImage = url ? "url('" + url + "')" : "";
  }

  function escapeGroupAboutHtml(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function applyGroupProfile({ name, about, avatarUrl, bannerUrl, avatarVersion, bannerVersion }) {
    if (typeof name !== "undefined") activeGroupName = String(name || "").trim();
    if (typeof about !== "undefined") activeGroupAbout = String(about || "");
    if (typeof avatarUrl !== "undefined" && String(avatarUrl || "").trim()) {
      activeGroupAvatarUrl = String(avatarUrl || "").trim();
    }
    if (typeof bannerUrl !== "undefined") {
      activeGroupBannerUrl = String(bannerUrl || "").trim();
    }
    if (avatarVersion) activeGroupAvatarVersion = Number(avatarVersion || Date.now()) || Date.now();
    if (bannerVersion) activeGroupBannerVersion = Number(bannerVersion || Date.now()) || Date.now();

    if (groupDisplayNameEl && activeGroupName) {
      groupDisplayNameEl.textContent = activeGroupName;
    }
    if (groupAboutTextEl) {
      const trimmed = activeGroupAbout.trim();
      groupAboutTextEl.innerHTML = trimmed
        ? escapeGroupAboutHtml(activeGroupAbout)
        : "This group hasn't added an About yet.";
    }
    if (groupAboutCard) {
      groupAboutCard.classList.toggle("controlProfileAbout--empty", !activeGroupAbout.trim());
    }
    if (groupAvatarImg && activeGroupAvatarUrl) {
      if (groupAvatarImg.tagName === "IMG") {
        groupAvatarImg.src = appendVersion(activeGroupAvatarUrl, activeGroupAvatarVersion);
      }
    }
    setBackgroundImage(
      groupBannerImage,
      activeGroupBannerUrl
        ? appendVersion(activeGroupBannerUrl, activeGroupBannerVersion)
        : "",
    );
  }

  async function saveGroupProfile(form, params) {
    const action = form?.getAttribute("action");
    if (!action) return null;
    const bodyParams = params || new URLSearchParams(new FormData(form));
    const res = await fetch(action, {
      method: "POST",
      headers: {
        "Accept": "application/json",
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
      },
      body: bodyParams.toString(),
      credentials: "include",
    });
    const data = await res.json().catch(() => null);
    if (!res.ok || !data || !data.ok) {
      throw new Error(data?.message || data?.error || "Could not save group profile.");
    }
    return data;
  }

  async function saveGroupCommandSettings(form, params) {
    const bodyParams = params || new URLSearchParams(new FormData(form));
    const res = await fetch("/api/community/groups/" + encodeURIComponent(groupKey) + "/commands", {
      method: "POST",
      headers: {
        "Accept": "application/json",
        "X-Requested-With": "XMLHttpRequest",
        "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
      },
      body: bodyParams.toString(),
      credentials: "include",
    });
    const data = await res.json().catch(() => null);
    if (!res.ok || !data || !data.ok) {
      throw new Error(data?.message || data?.error || "Could not save command settings.");
    }
    return data;
  }

  async function submitGroupCommandSettings(form) {
    const submitBtn = form.querySelector('button[type="submit"]');
    const previousLabel = submitBtn?.textContent || "Save Group";
    const params = new URLSearchParams(new FormData(form));

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Saving...";
    }
    setGroupEditBusy(form, true);
    setGroupEditStatus(form, "Saving...");

    try {
      const profileData = await saveGroupProfile(form, params);
      const commandData = await saveGroupCommandSettings(form, params);
      applyCommunityGroupCommandPrefs(commandData?.prefs || {});
      applyGroupProfile({
        name: profileData?.group?.name,
        about: profileData?.group?.description,
        avatarUrl: profileData?.group?.iconUrl,
        bannerUrl: profileData?.group?.bannerUrl,
        avatarVersion: profileData?.group?.avatarVersion,
        bannerVersion: profileData?.group?.bannerVersion,
      });
      setGroupEditStatus(form, "Group saved.", "success");
      addLine("Group settings saved.", "ok");
      window.setTimeout(hideCmdModal, 220);
    } catch (err) {
      setGroupEditStatus(form, err?.message || "Could not save group.", "error");
      addLine(err?.message || "Could not save group settings.", "error");
    } finally {
      setGroupEditBusy(form, false);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = previousLabel;
      }
    }
  }

  function initPlaySoundForm(form) {
    const urlEnabled = form.dataset.psUrlEnabled === "1";

    const select = form.querySelector(".psSelect");
    const urlInput = form.querySelector(".psUrlInput");

    const hidKind = form.querySelector('input[type="hidden"][name="kind"]');
    const hidName = form.querySelector('input[type="hidden"][name="name"]');
    const hidUrl  = form.querySelector('input[type="hidden"][name="url"]');

    form.addEventListener("submit", (e) => {
      const selected = String(select?.value || "").trim();
      const typedUrl = urlEnabled ? String(urlInput?.value || "").trim() : "";

      if (urlEnabled && typedUrl) {
        hidKind.value = "url";
        hidUrl.value = typedUrl;
        hidName.value = "";
        return;
      }

      if (selected) {
        hidKind.value = "builtin";
        hidName.value = selected;
        hidUrl.value = "";
        return;
      }

      e.preventDefault();
      addLine("Pick a built-in sound, or enter a URL.", "error");
    }, { capture: true });
  }

  function createSubliminalMessageRow() {
    const row = document.createElement("div");
    row.className = "subliminalMessageRow subliminalMessageRow--removable";

    const textarea = document.createElement("textarea");
    textarea.name = "messages";
    textarea.maxLength = 2000;
    textarea.placeholder = "Another message";
    textarea.dataset.subliminalMessage = "1";

    const removeBtn = document.createElement("button");
    removeBtn.type = "button";
    removeBtn.className = "subliminalMessageRemoveBtn";
    removeBtn.dataset.subliminalRemove = "1";
    removeBtn.setAttribute("aria-label", "Remove message");
    removeBtn.innerHTML = `
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm1 7h2v8h-2v-8Zm4 0h2v8h-2v-8ZM7 10h2v8H7v-8Zm-1 10h12l1-12H5l1 12Z" fill="currentColor"></path>
      </svg>
    `;

    row.appendChild(textarea);
    row.appendChild(removeBtn);
    return row;
  }

  function initSubliminalMessageForm(form) {
    if (!form || form.dataset.subliminalInit === "1") return;
    form.dataset.subliminalInit = "1";

    const list = form.querySelector('[data-subliminal-message-list="1"]');
    const addBtn = form.querySelector('[data-subliminal-add="1"]');
    if (!list || !addBtn) return;

    addBtn.addEventListener("click", () => {
      const row = createSubliminalMessageRow();
      list.appendChild(row);
      row.querySelector("textarea")?.focus();
    });

    form.addEventListener("click", (e) => {
      const removeBtn = e.target?.closest?.('[data-subliminal-remove="1"]');
      if (!removeBtn) return;
      e.preventDefault();
      removeBtn.closest(".subliminalMessageRow")?.remove();
    });
  }

  function initGroupEditForm(form) {
    if (!form || form.dataset.groupEditInit === "1") return;
    form.dataset.groupEditInit = "1";

    const nameInput = form.querySelector("#groupEditNameInput");
    const aboutInput = form.querySelector("#groupEditAboutInput");
    const aboutCount = form.querySelector("#groupEditAboutCount");
    const avatarPreview = form.querySelector("#groupEditAvatarPreview");
    const avatarInput = form.querySelector("#groupEditAvatarInput");
    const avatarUploadBtn = form.querySelector("#groupEditAvatarUploadBtn");
    const avatarDeleteBtn = form.querySelector("#groupEditAvatarDeleteBtn");
    const bannerPreview = form.querySelector("#groupEditBannerPreview");
    const bannerInput = form.querySelector("#groupEditBannerInput");
    const bannerUploadBtn = form.querySelector("#groupEditBannerUploadBtn");
    const bannerDeleteBtn = form.querySelector("#groupEditBannerDeleteBtn");
    const groupDeleteBtn = form.querySelector("#groupDeleteBtn");
    let busy = false;

    function syncAboutCount() {
      if (!aboutInput || !aboutCount) return;
      const max = Number(aboutInput.getAttribute("maxlength") || 220) || 220;
      if (aboutInput.value.length > max) {
        aboutInput.value = aboutInput.value.slice(0, max);
      }
      aboutCount.textContent = aboutInput.value.length + "/" + max;
    }

    function renderAssetControls() {
      if (avatarPreview) {
        avatarPreview.src = appendVersion(activeGroupAvatarUrl || "/default-avatar.svg", activeGroupAvatarVersion);
      }
      if (avatarDeleteBtn) avatarDeleteBtn.hidden = !activeGroupHasCustomAvatar;
      setBackgroundImage(
        bannerPreview,
        activeGroupBannerUrl
          ? appendVersion(activeGroupBannerUrl, activeGroupBannerVersion)
          : "",
      );
      if (bannerDeleteBtn) bannerDeleteBtn.hidden = !activeGroupHasCustomBanner;
    }

    async function uploadAsset(kind, file) {
      if (!file || busy) return;
      busy = true;
      setGroupEditBusy(form, true);
      setGroupEditStatus(form, "Uploading...");

      try {
        const dataUrl = await fileToDataUrl(file);
        const res = await fetch(
          "/api/community/groups/" + encodeURIComponent(groupKey) + "/" + kind,
          {
            method: "POST",
            headers: {
              "Accept": "application/json",
              "X-Requested-With": "XMLHttpRequest",
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              filename: file.name || kind + "-upload",
              mime: file.type || "application/octet-stream",
              data: dataUrl,
            }),
            credentials: "include",
          },
        );
        const data = await res.json().catch(() => null);
        if (!res.ok || !data || !data.ok) {
          throw new Error(data?.message || data?.error || "Could not upload image.");
        }

        if (kind === "avatar") {
          activeGroupHasCustomAvatar = !!data.hasCustomAvatar;
          activeGroupAvatarVersion = Number(data.updatedAt || Date.now()) || Date.now();
          activeGroupAvatarUrl = data.avatarUrl || activeGroupAvatarUrl;
          applyGroupProfile({
            avatarUrl: activeGroupAvatarUrl,
            avatarVersion: activeGroupAvatarVersion,
          });
        } else {
          activeGroupHasCustomBanner = !!data.hasCustomBanner;
          activeGroupBannerVersion = Number(data.updatedAt || Date.now()) || Date.now();
          activeGroupBannerUrl = data.bannerUrl || activeGroupBannerUrl;
          applyGroupProfile({
            bannerUrl: activeGroupBannerUrl,
            bannerVersion: activeGroupBannerVersion,
          });
        }
        renderAssetControls();
        setGroupEditStatus(form, kind === "avatar" ? "Avatar uploaded." : "Banner uploaded.", "success");
      } catch (err) {
        setGroupEditStatus(form, err?.message || "Could not upload image.", "error");
      } finally {
        busy = false;
        setGroupEditBusy(form, false);
        if (avatarInput) avatarInput.value = "";
        if (bannerInput) bannerInput.value = "";
      }
    }

    async function deleteAsset(kind) {
      if (busy) return;
      busy = true;
      setGroupEditBusy(form, true);
      setGroupEditStatus(form, "Removing...");

      try {
        const res = await fetch(
          "/api/community/groups/" + encodeURIComponent(groupKey) + "/" + kind + "/delete",
          {
            method: "POST",
            headers: {
              "Accept": "application/json",
              "X-Requested-With": "XMLHttpRequest",
            },
            credentials: "include",
          },
        );
        const data = await res.json().catch(() => null);
        if (!res.ok || !data || !data.ok) {
          throw new Error(data?.message || data?.error || "Could not remove image.");
        }

        if (kind === "avatar") {
          activeGroupHasCustomAvatar = false;
          activeGroupAvatarVersion = Number(data.updatedAt || Date.now()) || Date.now();
          activeGroupAvatarUrl = data.avatarUrl || activeGroupAvatarUrl;
          applyGroupProfile({
            avatarUrl: activeGroupAvatarUrl,
            avatarVersion: activeGroupAvatarVersion,
          });
        } else {
          activeGroupHasCustomBanner = false;
          activeGroupBannerVersion = Number(data.updatedAt || Date.now()) || Date.now();
          activeGroupBannerUrl = "";
          applyGroupProfile({ bannerUrl: "" });
        }
        renderAssetControls();
        setGroupEditStatus(form, kind === "avatar" ? "Avatar removed." : "Banner removed.", "success");
      } catch (err) {
        setGroupEditStatus(form, err?.message || "Could not remove image.", "error");
      } finally {
        busy = false;
        setGroupEditBusy(form, false);
      }
    }

    async function deleteGroup() {
      if (busy) return;
      const groupName = (activeGroupName || groupKey || "this group").trim();
      if (!window.confirm("Delete " + groupName + "? This permanently removes the group, chat, members, invites, and command settings.")) {
        return;
      }

      busy = true;
      setGroupEditBusy(form, true);
      setGroupEditStatus(form, "Deleting group...");

      try {
        const res = await fetch("/api/community/groups/" + encodeURIComponent(groupKey), {
          method: "DELETE",
          headers: {
            "Accept": "application/json",
            "X-Requested-With": "XMLHttpRequest",
          },
          credentials: "include",
        });
        const data = await res.json().catch(() => null);
        if (!res.ok || !data || !data.ok) {
          throw new Error(data?.message || data?.error || "Could not delete group.");
        }

        setGroupEditStatus(form, "Group deleted.", "success");
        window.location.assign(data.redirectUrl || "/discover?tab=community");
      } catch (err) {
        busy = false;
        setGroupEditBusy(form, false);
        setGroupEditStatus(form, err?.message || "Could not delete group.", "error");
      }
    }

    if (nameInput) nameInput.value = activeGroupName;
    if (aboutInput) aboutInput.value = activeGroupAbout;
    syncAboutCount();
    renderAssetControls();

