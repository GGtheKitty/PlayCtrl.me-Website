<!DOCTYPE html>
<html>

<head>
  <link rel="stylesheet" href="/css/main.css">
</head>

<body>
  <div class="homeWidgetGrid">
    <section class="card homeStatCard">
      <div class="cardHd">Live Site Snapshot</div>
      <div class="cardBd">
        <div class="homeStatValueWrap">
          <div class="homeStatValue"><%= Number(onlineUserCount || 0).toLocaleString() %></div>
          <span class="homeStatDot" aria-hidden="true"></span>
        </div>
        <div class="homeStatLabel">currently online users</div>
      </div>
    </section>

    <section class="card homeLeaderboardCard">
      <div class="cardHd">
        <span>Top 10 Today</span>
        <span class="homeLeaderboardStamp">UTC <%= leaderboardUtcDate %></span>
      </div>
      <div class="cardBd">
        <% if (Array.isArray(topSendersToday) && topSendersToday.length) { %>
          <ol class="homeLeaderboardList">
            <% topSendersToday.forEach((item, idx) => { %>
              <li class="homeLeaderboardItem">
                <div class="homeLeaderboardRank">#<%= idx + 1 %></div>
                <img class="homeLeaderboardAvatar" src="<%= item.avatarUrl %>" alt="" />
                <div class="homeLeaderboardBody">
                  <div class="homeLeaderboardName"><%= item.displayName %></div>
                  <div class="homeLeaderboardMeta"><%= item.username ? "@" + item.username : item.discordId %></div>
                </div>
                <div class="homeLeaderboardScore">
                  <span class="homeLeaderboardScoreValue"><%= Number(item.commandsSent || 0).toLocaleString() %></span>
                  <span class="homeLeaderboardScoreLabel">sent</span>
                </div>
              </li>
            <% }) %>
          </ol>
        <% } else { %>
          <div class="homeLeaderboardEmpty muted">No command activity has hit the board yet for this UTC day.</div>
        <% } %>
      </div>
    </section>

    <section class="card homeLeaderboardCard">
      <div class="cardHd">Top 10 All Time</div>
      <div class="cardBd">
        <% if (Array.isArray(topSendersAllTime) && topSendersAllTime.length) { %>
          <ol class="homeLeaderboardList">
            <% topSendersAllTime.forEach((item, idx) => { %>
              <li class="homeLeaderboardItem">
                <div class="homeLeaderboardRank">#<%= idx + 1 %></div>
                <img class="homeLeaderboardAvatar" src="<%= item.avatarUrl %>" alt="" />
                <div class="homeLeaderboardBody">
                  <div class="homeLeaderboardName"><%= item.displayName %></div>
                  <div class="homeLeaderboardMeta"><%= item.username ? "@" + item.username : item.discordId %></div>
                </div>
                <div class="homeLeaderboardScore">
                  <span class="homeLeaderboardScoreValue"><%= Number(item.commandsSent || 0).toLocaleString() %></span>
                  <span class="homeLeaderboardScoreLabel">total</span>
                </div>
              </li>
            <% }) %>
          </ol>
        <% } else { %>
          <div class="homeLeaderboardEmpty muted">No all-time send history to show yet.</div>
        <% } %>
      </div>
    </section>
  </div>

  <div class="homeInfoGrid">
    <div class="card">
      <div class="cardHd">What is this?</div>
      <div class="cardBd">
        <p class="muted"><span>PlayCtrl.me is a techdom app built for ADULTS ONLY. You must be 18 years old or older to use it. No exceptions.</span> This is an app heavily inspired by <strong>PlayMyPC</strong>, and allows users to send commands to their friend's PCs through device control links.</p>
      </div>
    </div>

    <div class="card">
      <div class="cardHd">How do I join?</div>
      <div class="cardBd">
        <p class="muted">This app uses <span>discord</span> for accounts, so long as you have a discord account you can login here. However, this site may not always have open enrollment. If that's the case, you'll have to wait for enrollment to open up again.</p>
      </div>
    </div>

    <div class="card">
      <div class="cardHd">How do I get started?</div>
      <div class="cardBd">
        <p class="muted"><strong>1)</strong> Go to your <span>profile</span></p>
        <p class="muted"><strong>2)</strong> <span>Download</span> the client (currently Windows only)</p>
        <p class="muted"><strong>3)</strong> <span>Pair</span> the client using the code on your profile</p>
        <p class="muted"><strong>4)</strong> <span>Share</span> your control page to others</p>
        <br>
        <p class="muted"><strong>If you ever have any issues, right click the app inside of your app tray and select "Check for updates"</strong></p>
      </div>
    </div>

    <div class="card">
      <div class="cardHd">How can I help?</div>
      <div class="cardBd">
        <img src="/public/gg_queen.png" alt="Art by Rapsik- on ych.commishes.com" style="height: 250px; padding: 18px; float: right;">
        <p class="muted">If you wish to help with moderation, I may end up allowing some people in as site admins to keep this place clean.<br><br>
          If you wish to help with the costs of hosting this service, please feel free to donate to my throne!
        </p>
        <a class="btn" href="https://throne.com/ggthekitty">Donate Here!</a>
      </div>
    </div>
  </div>
</body>

</html>
